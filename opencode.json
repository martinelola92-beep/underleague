{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": "deny",
    "bash": {
      "*": "allow",
      "git add*": "deny",
      "git commit*": "deny",
      "git push*": "deny",
      "git reset*": "deny",
      "git checkout*": "deny",
      "git switch*": "deny",
      "git rebase*": "deny",
      "git stash*": "deny",
      "git clean*": "deny",
      "git worktree*": "deny",
      "rm -rf*": "deny"
    }
  },
  "agent": {
    "lector": {
      "description": "Consultas de solo lectura sobre la documentación del repo, con citas verificables (tools/opencode-consulta.sh)",
      "mode": "primary",
      "permission": {
        "edit": "deny",
        "question": "deny",
        "task": "deny",
        "webfetch": "deny",
        "bash": {
          "*": "deny",
          "grep *": "allow",
          "rg *": "allow",
          "sed -n *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "wc *": "allow",
          "ls *": "allow",
          "cat *": "allow",
          "nl *": "allow"
        }
      }
    }
  }
}
