{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": "deny",
    "bash": {
      "*": "allow",
      "git add*": "deny",
      "git commit*": "deny",
      "git push*": "deny",
      "git reset*": "deny",
      "git checkout*": "deny",
      "git switch*": "deny",
      "git rebase*": "deny",
      "git stash*": "deny",
      "git clean*": "deny",
      "git worktree*": "deny",
      "rm -rf*": "deny"
    }
  }
}
