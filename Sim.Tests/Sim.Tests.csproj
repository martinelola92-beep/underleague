<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADR 0171: el director de presentación no toca Godot (sólo Sim.Run.View); se enlaza el fichero, no el
         proyecto, para probar su cola, sus pausas y la cámara lenta sin levantar el motor gráfico. -->
    <Compile Include="..\Game\Match\PresentationDirector.cs" Link="Linked\PresentationDirector.cs" />
    <!-- ADR 0173: la pregunta «¿este suceso detiene el juego?» del director; tampoco toca Godot. -->
    <Compile Include="..\Game\Match\PlayStops.cs" Link="Linked\PlayStops.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sim\Sim.csproj" />
    <!-- Reutiliza Balance/PerkValueRunner.cs (campaña con arrastre de contador, ADR 0070/0087) para
         los perks NeedsCampaignHarness — no se duplica su lógica (§16, encargo del 18 sep 2026). -->
    <ProjectReference Include="..\Balance\Balance.csproj" />
  </ItemGroup>

</Project>