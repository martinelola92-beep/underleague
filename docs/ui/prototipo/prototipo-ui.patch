@@ -0,0 +1,41 @@
+// Fase C.2 (copia temporal): busca semillas con gol propio, lesión con sustitución pendiente y muerte con sustitución pendiente.
+using System.Linq;
+using Godot;
+using Underleague.Game.Autoload;
+using Underleague.Sim.Events;
+using Underleague.Sim.Model;
+
+namespace Underleague.Game.Screens;
+
+public partial class C2Search : Control
+{
+    public override void _Ready()
+    {
+        var run = RunController.Instance!;
+        bool goal = false, inj = false, death = false;
+        goal = true; inj = true;
+        for (ulong s = 1; s <= 4000 && !(goal && inj && death); s++)
+        foreach (int nodeId in RunIds(run, s))
+        {
+            if (death) break;
+            run.NewRun("orc_ironworks", Race.Orc, s);
+            run.PlayMatch(nodeId);
+            var pb = run.Playback!; var ev = pb.Result.Events; var pend = run.PendingSubstitution();
+            var g = ev.FirstOrDefault(e => e.Type == EventType.Goal && e.Team == 0 && e.Tick > 150);
+            if (!goal && g is not null) { goal = true; GD.Print($"GOL semilla={s} tick={g.Tick} frames={pb.Result.Trace?.FrameCount} ticks={pb.Result.Report.Ticks}"); }
+            if (pend is not null)
+            {
+                var src = ev.Where(e => e.Tick <= pend.Tick && e.Tick >= pend.Tick - 3 && (e.Type == EventType.Injury || e.Type == EventType.Death)).Select(e => $"{e.Type}/{e.Detail}");
+                if (!inj && pend.Detail == "injury") { inj = true; GD.Print($"LESION semilla={s} tick={pend.Tick} sale={pend.OutPlayerId} candidatos={pend.Candidates.Count} sucesos={string.Join(",", src)}"); }
+                if (!death && pend.Detail == "death") { death = true; GD.Print($"MUERTE semilla={s} nodo={nodeId} tick={pend.Tick} sale={pend.OutPlayerId} candidatos={pend.Candidates.Count} sucesos={string.Join(",", src)}"); }
+            }
+        }
+        GetTree().Quit();
+    }
+
+    private static System.Collections.Generic.List<int> RunIds(RunController run, ulong s)
+    {
+        run.NewRun("orc_ironworks", Race.Orc, s);
+        return run.Available().Where(n => n.IsMatch).Select(n => n.Id).ToList();
+    }
+}
