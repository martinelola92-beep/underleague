+// Fase C — prototipo de composición y comportamiento en una COPIA temporal (fuera del repositorio).
+// Cajas grises; nada de lenguaje visual. Uso: -- <modo> <salida.png>
+// modos: base | alt | n3 | n3dim | n4 | final | dec | sinrecambio
+using System.Collections.Generic;
+using System.Linq;
+using Godot;
+using Underleague.Game.Autoload;
+using Underleague.Game.Ui;
+using Underleague.Sim.Model;
+
+namespace Underleague.Game.Screens;
+
+public partial class C1Capture : Control
+{
+    private const float Extent = 16f + (2f * 0.6f);
+    private MatchPitchView3D _pitch = null!;
+    private Control _overlay = null!;
+    private string _mode = "base", _out = "";
+    private int _frame, _top = -1, _mid = -1, _hero = -1;
+    private readonly List<(Rect2 R, string Tag)> _placed = new();
+    private float PanPx => _mode == "alt" ? 0f : 30f;
+
+    public override void _Ready()
+    {
+        var args = OS.GetCmdlineUserArgs();
+        if (args.Length >= 2) { _mode = args[0]; _out = args[1]; }
+        var run = RunController.Instance!;
+        run.NewRun("orc_ironworks", Race.Orc, 20260905UL);
+        run.PlayMatch(run.Available().First(n => n.IsMatch).Id);
+        var pb = run.Playback!; var trace = pb.Trace!;
+        _pitch = new MatchPitchView3D();
+        _pitch.SetAnchorsPreset(LayoutPreset.FullRect);
+        AddChild(_pitch);
+        _pitch.Bind(trace, pb.Setup, run.Catalog);
+        _frame = trace.FrameCount * 2 / 5;
+        for (int f = trace.FrameCount / 5; f < trace.FrameCount * 4 / 5; f++)
+        {
+            bool found = false;
+            for (int i = 0; i < trace.Players.Count; i++) if (trace.OnPitchAt(f, i) && trace.PositionAt(f, i).Y < 0.7f) { found = true; break; }
+            if (found) { _frame = f; break; }
+        }
+        _pitch.Frame = _frame;
+        var ball = trace.BallAt(_frame); float bt = 99, bm = 99, bh = 99;
+        for (int i = 0; i < trace.Players.Count; i++)
+        {
+            if (!trace.OnPitchAt(_frame, i)) continue;
+            var p = trace.PositionAt(_frame, i);
+            if (p.Y < bt) { bt = p.Y; _top = i; }
+            float dm = System.Math.Abs(p.Y - 3.5f) + (System.Math.Abs(p.X - 8f) * 0.2f); if (dm < bm) { bm = dm; _mid = i; }
+            float dh = ((p.X - ball.X) * (p.X - ball.X)) + ((p.Y - ball.Y) * (p.Y - ball.Y)); if (dh < bh) { bh = dh; _hero = i; }
+        }
+        _overlay = new Control { MouseFilter = MouseFilterEnum.Ignore };
+        _overlay.SetAnchorsPreset(LayoutPreset.FullRect);
+        AddChild(_overlay);
+        _ = Shoot();
+    }
+
+    public override void _Process(double delta)
+    {
+        var s = _pitch.Size;
+        if (s.Y <= 0) return;
+        _pitch.OrthoSize = Extent / (s.X / s.Y);
+        _pitch.PanUp = PanPx / (s.X / Extent);
+    }
+
+    private async System.Threading.Tasks.Task Shoot()
+    {
+        for (int i = 0; i < 20; i++) await ToSignal(GetTree(), SceneTree.SignalName.ProcessFrame);
+        Build();
+        for (int i = 0; i < 6; i++) await ToSignal(GetTree(), SceneTree.SignalName.ProcessFrame);
+        GetViewport().GetTexture().GetImage().SavePng(_out);
+        Report();
+        GetTree().Quit();
+    }
+
+    private ColorRect Box(float x, float y, float w, float h, string text, int font, string tag = "", Color? fill = null, bool center = false)
+    {
+        var r = new ColorRect { Position = new Vector2(x, y), Size = new Vector2(w, h), Color = fill ?? new Color(0.58f, 0.58f, 0.58f, 0.94f), MouseFilter = MouseFilterEnum.Ignore };
+        _overlay.AddChild(r);
+        if (text.Length > 0)
+        {
+            var l = new Label { Text = text, Position = new Vector2(8, 4), Size = new Vector2(w - 16, h - 8), ClipText = true, AutowrapMode = TextServer.AutowrapMode.WordSmart };
+            if (center) { l.HorizontalAlignment = HorizontalAlignment.Center; l.VerticalAlignment = VerticalAlignment.Center; }
+            l.AddThemeFontSizeOverride("font_size", font);
+            l.AddThemeColorOverride("font_color", new Color(0.05f, 0.05f, 0.05f));
+            r.AddChild(l);
+        }
+        if (tag.Length > 0) _placed.Add((new Rect2(x, y, w, h), tag));
+        return r;
+    }
+
+    private void Tira(float x, float y, string name, string sub, string tag, Color? fill = null)
+    {
+        Box(x, y, 232, 72, "", 20, tag, fill);
+        Box(x + 4, y + 4, 64, 64, "⛨", 26, "", new Color(0.36f, 0.36f, 0.36f, 0.95f), true);
+        foreach (var (t, yy) in new[] { (name, 6f), (sub, 38f) })
+        {
+            var l = new Label { Text = t, Position = new Vector2(x + 74, y + yy), Size = new Vector2(142, 28), ClipText = true };
+            l.AddThemeFontSizeOverride("font_size", 20); l.AddThemeColorOverride("font_color", Colors.Black); _overlay.AddChild(l);
+        }
+        Box(x + 218, y + 4, 10, 64, "", 10, "", new Color(0.25f, 0.25f, 0.25f, 1f));
+    }
+
+    private static readonly string[] Names = { "1 ORZUG QUIEBRAESPINAS", "2 GASHK TRAGACLAVOS", "3 RUK MUERDEHIERRO", "4 YAGUL COMECRÁNEOS", "5 THRAK DENTAZO", "6 URZAG PATEAMUROS", "7 GROM" };
+
+    private void Build()
+    {
+        var v = GetViewportRect().Size; float W = v.X, H = v.Y;
+        var P = _pitch.PitchRect();
+        var hero = _pitch.ScreenOf(_hero); var top = _pitch.ScreenOf(_top); var mid = _pitch.ScreenOf(_mid);
+
+        // Escenas N4: el mundo pasa a segundo plano (hipótesis de B: escena = mundo atenuado).
+        if (_mode is "n4" or "final") Box(0, 0, W, H, "", 10, "", new Color(0f, 0f, 0f, 0.62f));
+        if (_mode == "n3dim") Box(P.Position.X, P.Position.Y, P.Size.X, P.Size.Y, "", 10, "", new Color(0f, 0f, 0f, 0.35f));
+
+        // Franja superior compacta (C13 paso 1-2): marcador 760x64, progreso 560x8, placa de estado 320x36.
+        if (_mode != "final")
+        {
+            Box(24, 12, 56, 56, "árb", 20, "hud");
+            Box((W - 760) / 2, 12, 760, 64, "⛨ NUESTRO FC      2 ║ 1      RIVAL UTD ⛨   ▮1 ✚1", 28, "hud", null, true);
+            Box((W - 560) / 2, 82, 560, 8, "", 8, "hud", new Color(0.35f, 0.35f, 0.35f, 0.95f));
+            Box((W - 320) / 2, 96, 320, 36, "TURBA · GOL DE ORO", 20, "hud", null, true);
+            for (int i = 0; i < 4; i++) Box(W - 24 - ((4 - i) * 56), 12, 48, 48, new[] { "x1", "x4", "x16", "‖" }[i], 20, "hud", null, true);
+        }
+
+        float ty = H - 18 - 72, x0 = (W - ((7 * 232) + (6 * 12) + 24 + 150)) / 2;
+        bool decision = _mode is "dec" or "sinrecambio";
+        if (!decision && _mode is not ("n4" or "final"))
+        {
+            for (int i = 0; i < 7; i++) Tira(x0 + (i * 244), ty, Names[i], "◆DEL · orco ✦2", "tiras");
+            Box(x0 + (7 * 244) + 12, ty, 150, 72, "BANQUILLO 2", 20, "tiras", null, true);
+        }
+
+        switch (_mode)
+        {
+            case "base":
+            case "alt":
+                // N1: marca de perk pegada a la cabeza; sello N2 sobre un jugador del medio;
+                // sello N1 del jugador de la fila superior desplazado LATERALMENTE hacia el centro (regla de B.1).
+                if (hero.Visible) Box(hero.Head.X - 60, hero.Head.Y - 6 - 36, 120, 36, "✦ Sangre cal.", 20, "marca");
+                if (mid.Visible) Box(mid.Head.X - 95, mid.Head.Y - 12 - 64, 190, 64, "NO LO HA VISTO", 24, "sello", null, true);
+                if (top.Visible)
+                {
+                    float sx = top.Head.X > W / 2 ? top.Head.X - 48 - 150 : top.Head.X + 48;
+                    Box(sx, top.Head.Y - 8, 150, 56, "¡FALTA!", 26, "sello", null, true);
+                }
+                break;
+            case "n3":
+            case "n3dim":
+            {
+                // N3 a 0,7x (574x364) + subtítulo, en la mitad opuesta al protagonista (C5 abierta), centrada sobre el campo.
+                float pw = 574, ph = 364, sub = 46;
+                float cx = hero.Foot.X < W / 2 ? P.Position.X + (P.Size.X * 0.75f) : P.Position.X + (P.Size.X * 0.25f);
+                float py = P.Position.Y + ((P.Size.Y - ph - sub - 6) / 2);
+                Box(cx - (pw / 2), py, pw, ph, "VIÑETA N3\n¡CRAC!", 44, "n3");
+                Box(cx - (pw / 2), py + ph + 6, pw, sub, "ROJA · LESIÓN GRAVE", 24, "n3", null, true);
+                Mark(hero);
+                break;
+            }
+            case "n4":
+            {
+                // Esquela (B5) ~900x760 centrada; el marcador sigue arriba.
+                float w = 900, h = 760, x = (W - w) / 2, y = 150 + ((H - 150 - h) / 2);
+                Box(x, y, w, h, "", 20, "n4");
+                string[] lines = { "HA CAÍDO", "⛨ 7 · ORZUG QUIEBRAESPINAS (orco)", "Rematado por «Sed de tuétano» de GRUNK (n.º 4)", "El hacha vuelve al almacén", "Disponibles 6 → 5" };
+                int[] sizes = { 56, 32, 24, 24, 24 };
+                float yy = y + 40;
+                for (int i = 0; i < lines.Length; i++) { Box(x + 60, yy, w - 120, sizes[i] + 24, lines[i], sizes[i], "", new Color(0.7f, 0.7f, 0.7f, 1f), true); yy += sizes[i] + 60; }
+                break;
+            }
+            case "final":
+            {
