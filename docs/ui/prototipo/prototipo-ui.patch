+        if (rel >= 0)
+        {
+            var hero = _pitch.ScreenOf(Index(_scn == "gol" ? -99 : _outId, 0));
+            bool left = (_heroX < 8f);
+            if (Active("N3", rel)) { scene += "N3+"; DrawN3(W, H, left, rel); }
+            if (Active("ESQUELA_CENTRO", rel)) { scene += "N4centro+"; Box(_fx, (W - 900) / 2, 150 + ((H - 150 - 760) / 2), 900, 760, "HA CAÍDO\n\n⛨ nombre · posición · raza\nCausa: perk y autor\nEl objeto vuelve al almacén\nDisponibles 6 → 5", 32); }
+            if (Active("ESQUELA_BORDE", rel)) { scene += "N4borde+"; DrawEdge(W, H, left, rel, "ESQUELA_BORDE", 620, 640, "HA CAÍDO\n⛨ nombre · posición\nCausa: perk y autor\nObjeto → almacén\nDisponibles 6 → 5", 30); }
+            if (Active("RESIDUO", rel) && hero.Visible) Box(_fx, hero.Foot.X - 45, hero.Foot.Y - 6, 90, 14, "", 8, new Color(0.75f, 0.05f, 0.05f, 0.9f));
+            if (hero.Visible && _scn != "gol" && rel < ScriptEnd) { var red = new Color(0.9f, 0.15f, 0.15f); Box(_fx, hero.Foot.X - 48, hero.Head.Y - 50, 96, 4, "", 4, red); Box(_fx, hero.Foot.X - 48, hero.Foot.Y + 14, 96, 4, "", 4, red); }
+        }
+        if (scene != _lastScene) { _screenChanges++; _lastScene = scene; }
+    }
+
+    private void DrawN3(float W, float H, bool heroLeft, float rel)
+    {
+        string text = _scn == "gol" ? "¡GOOOL!\n(viñeta)" : "¡CRAC!\n(viñeta)";
+        string sub = _scn == "gol" ? "GOL · NUESTRO FC" : "LESIÓN · SALE EL N.º";
+        var P = _pitch.PitchRect();
+        if (_var == "A")
+        {
+            float pw = 574, ph = 364, cx = heroLeft ? P.Position.X + P.Size.X * 0.75f : P.Position.X + P.Size.X * 0.25f, py = P.Position.Y + (P.Size.Y - ph - 52) / 2;
+            Box(_fx, cx - pw / 2, py, pw, ph, text, 44); Box(_fx, cx - pw / 2, py + ph + 6, pw, 46, sub, 24);
+        }
+        else DrawEdge(W, H, heroLeft, rel, "N3", 560, 520, text + "\n" + sub, 40);
+    }
+
+    // Variante editorial: nace desde el borde contrario al protagonista, girada, parcialmente fuera de pantalla.
+    private void DrawEdge(float W, float H, bool heroLeft, float rel, string what, float w, float h, string text, int font)
+    {
+        var s = _script.First(x => x.What == what && rel >= x.A && rel < x.B);
+        float t = rel - s.A, tOut = s.B - rel;
+        float slide = Mathf.Clamp(System.Math.Min(t, tOut) / 0.22f, 0f, 1f);   // entra y sale deslizando ~0,22 s
+        slide = 1f - ((1f - slide) * (1f - slide));
+        bool fromRight = heroLeft;
+        float visible = w - 70;                                                  // 70 px quedan fuera de pantalla
+        float x = fromRight ? W - visible * slide : -70 - w + (visible + 70) * slide;
+        if (!fromRight) x = -70 + (visible * slide) - visible;
+        Box(_fx, x, 150, w, h, text, font, null, fromRight ? -0.06f : 0.06f);
+    }
+
+    private void Still(float rel)
+    {
+        foreach (var (at, name) in new[] { (0.1f, "a"), (1.2f, "b"), (2.6f, "c"), (4.6f, "d"), (ScriptEnd + 0.8f, "z") })
+        {
+            if (rel >= at && !_stills.Contains(name))
+            {
+                _stills.Add(name);
+                var img = GetViewport().GetTexture().GetImage(); img.SavePng($"{_out}-{name}.png");
+                var P = _pitch.PitchRect(); float area = P.Size.X * P.Size.Y, cov = 0;
+                foreach (var n in _fx.GetChildren().OfType<ColorRect>()) if (n.Size.X < 1900) cov += new Rect2(n.Position, n.Size).Intersection(P).Area;
+                var hero = _pitch.ScreenOf(Index(_outId, 0));
+                bool heroCovered = hero.Visible && _fx.GetChildren().OfType<ColorRect>().Any(n => n.Size.X > 200 && n.Size.X < 1900 && new Rect2(n.Position, n.Size).HasPoint(hero.Foot - new Vector2(0, 30)));
+                _log.Add($"foto {name} real={_real:0.00}s rel={rel:0.00}s escena=[{_lastScene}] campo tapado≈{cov / area:P0} protagonista tapado={heroCovered} congelado={_frozen}");
+            }
+        }
+    }
+
+    private void Finish()
+    {
+        _done = true;
+        _log.Add($"FIN clip: real={_real:0.00}s · cambios de escena={_screenChanges}");
+        foreach (var l in _log) GD.Print("C2 " + l);
+        GetTree().Quit();
+    }
+}
