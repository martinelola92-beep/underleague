+                    Box(290, ry + 20, 60, 32, "→", 26, "", new Color(0.7f, 0.7f, 0.7f, 1f), true);
+                    Tira(370, ry, "8 BRAKK OREJAROTA", "◆DEF · sano ✓", "", new Color(0.78f, 0.78f, 0.6f, 0.98f));
