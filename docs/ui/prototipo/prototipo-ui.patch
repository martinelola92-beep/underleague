+            }
+        }
+    }
+
+
+    private void Mark((Vector2 Head, Vector2 Foot, bool Visible) p)
+    {
+        if (!p.Visible) return;
+        var red = new Color(0.9f, 0.15f, 0.15f, 1f);
+        Box(p.Foot.X - 48, p.Head.Y - 50, 96, 4, "", 4, "", red); Box(p.Foot.X - 48, p.Foot.Y + 14, 96, 4, "", 4, "", red);
+        Box(p.Foot.X - 48, p.Head.Y - 50, 4, p.Foot.Y - p.Head.Y + 68, "", 4, "", red); Box(p.Foot.X + 44, p.Head.Y - 50, 4, p.Foot.Y - p.Head.Y + 68, "", 4, "", red);
+    }
+
+    private void Report()
+    {
+        var P = _pitch.PitchRect(); float area = P.Size.X * P.Size.Y;
+        var hero = _pitch.ScreenOf(_hero); var top = _pitch.ScreenOf(_top);
+        var heroRect = new Rect2(hero.Foot.X - 45, hero.Head.Y - 45, 90, hero.Foot.Y - hero.Head.Y + 60);
+        var topBody = new Rect2(top.Foot.X - 45, top.Head.Y - 45, 90, top.Foot.Y - top.Head.Y + 60);
+        var byTag = _placed.GroupBy(x => x.Tag).Select(g => $"{g.Key} {g.Sum(x => x.R.Intersection(P).Area) / area:P0}");
+        bool heroHidden = _placed.Any(x => x.Tag is "n3" or "n4" or "bandeja" or "tiras" or "hud" && x.R.Intersects(heroRect));
+        bool topHidden = _placed.Any(x => x.Tag is "hud" && x.R.Intersects(topBody));
+        float hudBottom = _placed.Where(x => x.Tag == "hud").Select(x => x.R.End.Y).DefaultIfEmpty(0).Max();
+        float tirasTop = _placed.Where(x => x.Tag is "tiras" or "bandeja").Select(x => x.R.Position.Y).DefaultIfEmpty(0).Min();
+        GD.Print($"C1 {_mode} lógico={GetViewportRect().Size} campo=y{P.Position.Y:0}-{P.End.Y:0} · franjaSup hasta y{hudBottom:0} · cuerpo filaSup desde y{topBody.Position.Y:0} (choca HUD: {topHidden}) · "
+            + $"hueco campo→tiras {tirasTop - P.End.Y:0}px · campo tapado: {string.Join(", ", byTag)} · protagonista tapado: {heroHidden}");
+    }
+}
diff -ruN a/Game/Screens/C2Check.cs b/Game/Screens/C2Check.cs
