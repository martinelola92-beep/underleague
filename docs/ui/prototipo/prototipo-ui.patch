+    private float _t0 = -1;   // instante real en que empieza el momento principal
+    private readonly HashSet<string> _stills = new();
+
+    public override void _Ready()
+    {
+        var a = OS.GetCmdlineUserArgs();
+        _scn = a[0]; _var = a[1]; _speed = int.Parse(a[2]); _out = a[3];
+        ulong seed = ulong.Parse(a[4]);
+        _run = RunController.Instance!;
+        _run.NewRun("orc_ironworks", Race.Orc, seed);
+        int node = a.Length > 5 ? int.Parse(a[5]) : _run.Available().First(n => n.IsMatch).Id;
+        _run.PlayMatch(node);
+        var pb = _run.Playback!;
+        if (_scn == "gol") _event = pb.Result.Events.First(e => e.Type == EventType.Goal && e.Team == 0 && e.Tick > 150).Tick;
+        else
+        {
+            var p = _run.PendingSubstitution()!;
+            _event = p.Tick; _outId = p.OutPlayerId; _inId = p.Candidates[0].Id;
+        }
+        _pitch = new MatchPitchView3D(); _pitch.SetAnchorsPreset(LayoutPreset.FullRect); AddChild(_pitch);
+        _hud = new Control { MouseFilter = MouseFilterEnum.Ignore }; _hud.SetAnchorsPreset(LayoutPreset.FullRect); AddChild(_hud);
+        _fx = new Control { MouseFilter = MouseFilterEnum.Ignore }; _fx.SetAnchorsPreset(LayoutPreset.FullRect); AddChild(_fx);
+        Rebind();
+        _tick = System.Math.Max(0, _event - 90);
+        _end = _event + 150;
+        BuildScript();
+    }
+
+    private void Rebind()
+    {
+        var pb = _run.Playback!; _pitch.Bind(pb.Result.Trace, pb.Setup, _run.Catalog);
+        var tr = pb.Result.Trace!;
+        var home = Enumerable.Range(0, tr.Players.Count).Where(i => tr.Players[i].Team == 0).ToList();
+        int f = tr.FrameOfTick((int)_tick), k = 0;
+        foreach (int i in home) if (tr.OnPitchAt(f, i) && k < 7) { _ids[k] = tr.Players[i].Id; _names[k++] = $"{tr.Players[i].Number} {tr.Players[i].Name.ToUpperInvariant()}"; }
+    }
+
+    private int Index(int playerId, int team)
+    {
+        var tr = _run.Playback!.Result.Trace!;
+        for (int i = 0; i < tr.Players.Count; i++) if (tr.Players[i].Id == playerId && tr.Players[i].Team == team) return i;
+        return -1;
+    }
+
+    // --------------------------------------------------------------- guion del momento principal
+    private void BuildScript()
+    {
+        bool fast = _speed == 16;
+        if (_scn == "gol")
+        {
+            if (!fast) _script.Add((0f, 3f, "N3"));           // viñeta 3 s congelada sobre el último fotograma antes de recolocar
+            return;
+        }
+        if (_scn == "lesion")
+        {
+            float d = fast ? 0f : 3f;
+            if (!fast) _script.Add((0f, 3f, "N3"));
+            _script.Add((d, d + 2.6f, "TRAY"));                 // decisión: 2,6 s de "usuario" simulado
+            return;
+        }
+        // muerte
+        if (fast) { _script.Add((0f, 1.0f, "ESQUELA_BORDE")); _script.Add((1.0f, 3.6f, "TRAY")); _script.Add((1.0f, 3.6f, "ESQUELA_BORDE")); return; }
+        if (_var == "A") { _script.Add((0f, 4f, "ESQUELA_CENTRO")); _script.Add((4f, 6.6f, "TRAY")); return; }
+        _script.Add((0f, 1.6f, "PUNCH")); _script.Add((0f, 99f, "RESIDUO"));
+        _script.Add((1.6f, 4.0f, "ESQUELA_BORDE")); _script.Add((4.0f, 6.6f, "TRAY")); _script.Add((4.0f, 6.6f, "ESQUELA_BORDE"));
+    }
+
+    private float ScriptEnd => _script.Count == 0 ? 0 : _script.Where(s => s.What != "RESIDUO").Max(s => s.B);
+    private bool Active(string what, float rel) => _script.Any(s => s.What == what && rel >= s.A && rel < s.B);
+
+    public override void _Process(double delta)
+    {
+        if (_done) return;
+        float dt = (float)delta; _real += dt;
+        var pb = _run.Playback!; var tr = pb.Result.Trace!;
+        // momento principal
+        if (_t0 < 0 && _tick >= _event) { _t0 = _real; _heroX = 0; if (_scn != "gol") { int hi = Index(_outId, 0); var p = tr.PositionAt(tr.FrameOfTick(_event - 1), hi); _heroX = p.X; _heroY = p.Y; } else { var b = tr.BallAt(tr.FrameOfTick(_event)); _heroX = b.X; _heroY = b.Y; } }
+        float rel = _t0 < 0 ? -1 : _real - _t0;
+        bool inMoment = rel >= 0 && rel < ScriptEnd;
+        // congelación: gol congela tras 1 s de balón muerto natural (15 ticks); lesión/muerte congelan en el acto
+        bool freeze = inMoment;   // C.2: el gol congela YA: el motor recoloca a todos en el mismo tick del gol
+        if (!_decided && rel >= 0 && _scn != "gol" && Active("TRAY", rel) && rel > _script.First(s => s.What == "TRAY").A + 2.0f) Decide();
+        if (!freeze) _tick = System.Math.Min(_tick + (15f * _speed * dt), tr.TickAt(tr.FrameCount - 1));
+        if (freeze && !_frozen) _log.Add($"congela en real={_real:0.00}s tick={_tick:0}");
+        if (!freeze && _frozen) _log.Add($"reanuda en real={_real:0.00}s tick={_tick:0}");
+        _frozen = freeze;
+        int frame = tr.FrameOfTick(freeze ? _event - 1 : (int)_tick);   // C.2: el motor cambia el estado EN el tick del suceso; se congela el anterior
+        _pitch.Frame = frame; _pitch.Alpha = freeze ? 0f : _tick - tr.TickAt(frame);
+        // cámara: campo entero + gesto (punch-in) solo en PUNCH
+        float targetZoom = rel >= 0 && Active("PUNCH", rel) ? 0.62f : 1f;
+        var targetFocus = rel >= 0 && Active("PUNCH", rel) ? new Vector3(_heroX - 8f, 0f, _heroY - 3.5f) : Vector3.Zero;
+        _zoom = Mathf.Lerp(_zoom, targetZoom, System.Math.Min(1f, dt * 8f)); _focus = _focus.Lerp(targetFocus, System.Math.Min(1f, dt * 8f));
+        var s = _pitch.Size; if (s.Y > 0) { _pitch.OrthoSize = Extent / (s.X / s.Y) * _zoom; _pitch.PanUp = PanPx / (s.X / Extent) * _zoom; _pitch.Focus = _focus; }
+        Draw(rel);
+        if (rel >= 0) Still(rel);
+        if (_tick >= _end || (_tick >= tr.TickAt(tr.FrameCount - 1) && !freeze)) Finish();
+    }
+
+    private void Decide()
+    {
+        _decided = true;
+        _run.Substitute(new Substitution(_event, _outId, _inId));
+        Rebind();
+        _log.Add($"decisión confirmada en real={_real:0.00}s (entra {_inId} por {_outId}); partido re-simulado");
+    }
+
+    // --------------------------------------------------------------- dibujo (cajas grises)
+    private readonly Color Grey = new(0.58f, 0.58f, 0.58f, 0.95f);
+    private ColorRect Box(Control parent, float x, float y, float w, float h, string text, int font, Color? c = null, float rot = 0f)
+    {
+        var r = new ColorRect { Position = new Vector2(x, y), Size = new Vector2(w, h), Color = c ?? Grey, MouseFilter = MouseFilterEnum.Ignore, Rotation = rot };
+        parent.AddChild(r);
+        if (text.Length > 0)
+        {
+            var l = new Label { Text = text, Size = new Vector2(w, h), HorizontalAlignment = HorizontalAlignment.Center, VerticalAlignment = VerticalAlignment.Center, AutowrapMode = TextServer.AutowrapMode.WordSmart };
+            l.AddThemeFontSizeOverride("font_size", font); l.AddThemeColorOverride("font_color", new Color(0.05f, 0.05f, 0.05f)); r.AddChild(l);
+        }
+        return r;
+    }
+
+    private string _lastScene = "";
+    private void Draw(float rel)
+    {
+        foreach (var c in _hud.GetChildren()) c.QueueFree();
+        foreach (var c in _fx.GetChildren()) c.QueueFree();
+        var v = GetViewportRect().Size; float W = v.X, H = v.Y;
+        var pb = _run.Playback!; var ev = pb.Result.Events; var tr = pb.Result.Trace!;
+        int now = (int)_tick;
+        int gf = ev.Count(e => e.Type == EventType.Goal && e.Team == 0 && e.Tick <= now), ga = ev.Count(e => e.Type == EventType.Goal && e.Team == 1 && e.Tick <= now);
+        int rr = ev.Count(e => e.Type == EventType.Card && e.Team == 1 && e.Detail == "red" && e.Tick <= now);
+        int rb = ev.Count(e => (e.Type == EventType.Injury || e.Type == EventType.Death) && e.Team == 1 && e.Tick <= now && !e.Detail.EndsWith(":cancelled"));
+        string scene = "";
+        // escena N4 en el centro atenúa el mundo
+        if (rel >= 0 && Active("ESQUELA_CENTRO", rel)) Box(_fx, 0, 0, W, H, "", 10, new Color(0, 0, 0, 0.62f));
+        // Tablero
+        Box(_hud, 24, 12, 56, 56, "árb", 20);
+        Box(_hud, (W - 760) / 2, 12, 760, 64, $"⛨ NUESTRO FC      {gf} ║ {ga}      RIVAL ⛨   ▮{rr} ✚{rb}", 28);
+        float prog = _tick / 1200f;
+        Box(_hud, (W - 560) / 2, 82, 560, 8, "", 8, new Color(0.35f, 0.35f, 0.35f, 0.95f));
+        Box(_hud, (W - 560) / 2, 82, 560 * System.Math.Min(1f, prog), 8, "", 8, new Color(0.85f, 0.85f, 0.85f, 1f));
+        Box(_hud, W - 24 - 4 * 68, 12, 60, 48, $"x{_speed}", 20);
+        Box(_hud, W - 24 - 3 * 68, 12, 60, 48, _frozen ? "‖ pausa" : "‖", 20, _frozen ? new Color(0.8f, 0.8f, 0.5f, 1) : null);
+        float ty = H - 18 - 72, x0 = (W - ((7 * 232) + (6 * 12) + 24 + 150)) / 2;
+        bool tray = rel >= 0 && Active("TRAY", rel);
+        if (!tray)
+        {
+            for (int i = 0; i < 7; i++)
+            {
+                bool outp = _ids[i] == _outId && _t0 >= 0 && !_decided;
+                var c = outp ? (_scn == "muerte" ? new Color(0.25f, 0.25f, 0.25f, 0.95f) : new Color(0.72f, 0.45f, 0.45f, 0.95f)) : Grey;
+                Box(_hud, x0 + i * 244, ty, 232, 72, _names[i] ?? "", 20, c);
+            }
+            Box(_hud, x0 + 7 * 244 + 12, ty, 150, 72, $"BANQUILLO {(_decided ? 1 : 2)}", 20);
+        }
+        else
+        {
+            scene += "bandeja+";
+            var P = _pitch.PitchRect(); float by = P.End.Y + 14, bh = H - 12 - by;
+            Box(_hud, 24, by, W - 48, bh, "", 20, new Color(0.5f, 0.5f, 0.5f, 0.96f));
+            float ry = by + (bh - 72) / 2;
+            Box(_hud, 40, ry, 232, 72, $"SALE · {(_scn == "muerte" ? "muerto" : "lesión")}", 20, new Color(0.72f, 0.45f, 0.45f, 0.95f));
+            float trel = rel - _script.First(s => s.What == "TRAY").A;
+            bool sel2 = trel > 0.8f && trel < 1.5f;
+            Box(_hud, 300, ry, 232, 72, "CANDIDATO A ✓", 20, !sel2 ? new Color(0.8f, 0.8f, 0.55f, 1) : Grey);
+            Box(_hud, 544, ry, 232, 72, "CANDIDATO B", 20, sel2 ? new Color(0.8f, 0.8f, 0.55f, 1) : Grey);
+            Box(_hud, W - 280, ry + 10, 240, 52, trel > 1.9f ? "✓ CONFIRMADO" : "CONFIRMAR", 22, trel > 1.9f ? new Color(0.6f, 0.8f, 0.6f, 1) : null);
+        }
+        // sellos N1/N2 y marcas de perk (x1/x4), por sucesos reales cercanos
+        if (_speed != 16)
+        {
+            float win = 15f * _speed;   // 1 s real
+            foreach (var e in ev.Where(e => e.Tick <= now && e.Tick > now - win * (e.Type == EventType.Card ? 1.5f : 1f)))
+            {
+                string label = e.Type switch { EventType.Foul => e.Detail == "unseen" ? "NO LO HA VISTO" : "¡FALTA!", EventType.Card => e.Detail == "red" ? "¡ROJA!" : "AMARILLA", EventType.PerkTriggered when e.Tick > 15 => "✦ " + e.Detail, _ => "" };
+                if (label == "") continue;
+                int pi = Index(e.Actor, e.Team); if (pi < 0) continue;
+                var sp = _pitch.ScreenOf(pi); if (!sp.Visible) continue;
+                bool perk = e.Type == EventType.PerkTriggered;
