+// B.1 — validación geométrica en una COPIA temporal del proyecto (fuera del repositorio).
+// Cajas grises con las medidas de la fase B sobre el campo 3D real con la cámara táctica a campo entero.
+// Uso: godot --path Game --scene res://Scenes/B1.tscn -- <hud|n3|n3dec> <salida.png>
+using System.Linq;
+using Godot;
+using Underleague.Game.Autoload;
+using Underleague.Game.Ui;
+using Underleague.Sim.Model;
+
+namespace Underleague.Game.Screens;
+
+public partial class B1Capture : Control
+{
+    private const float Extent = 16f + (2f * 0.6f);   // campo + 0,6 casillas por lado (fase B §0)
+    private MatchPitchView3D _pitch = null!;
+    private Control _overlay = null!;
+    private string _mode = "hud", _out = "";
+    private int _frame, _top = -1, _mid = -1, _hero = -1;
+
+    public override void _Ready()
+    {
+        var args = OS.GetCmdlineUserArgs();
+        if (args.Length >= 2) { _mode = args[0]; _out = args[1]; }
+        var run = RunController.Instance!;
+        run.NewRun("orc_ironworks", Race.Orc, 20260905UL);
+        int node = run.Available().First(n => n.IsMatch).Id;
+        run.PlayMatch(node);
+        var pb = run.Playback!;
+        var trace = pb.Trace!;
+
+        _pitch = new MatchPitchView3D();
+        _pitch.SetAnchorsPreset(LayoutPreset.FullRect);
+        AddChild(_pitch);
+        _pitch.Bind(trace, pb.Setup, run.Catalog);
+        _frame = trace.FrameCount * 2 / 5;
+        // peor caso del sello: un fotograma con alguien en la fila superior (y < 0,7)
+        for (int f = trace.FrameCount / 5; f < trace.FrameCount * 4 / 5; f++)
+        {
+            bool found = false;
+            for (int i = 0; i < trace.Players.Count; i++)
+                if (trace.OnPitchAt(f, i) && trace.PositionAt(f, i).Y < 0.7f) { found = true; break; }
+            if (found) { _frame = f; break; }
+        }
+        _pitch.Frame = _frame;
+
+        var ball = trace.BallAt(_frame);
+        float best = 99f, bestMid = 99f, bestHero = 99f;
+        for (int i = 0; i < trace.Players.Count; i++)
+        {
+            if (!trace.OnPitchAt(_frame, i)) continue;
+            var p = trace.PositionAt(_frame, i);
+            if (p.Y < best) { best = p.Y; _top = i; }
+            float dm = System.Math.Abs(p.Y - 3.5f) + System.Math.Abs(p.X - 8f) * 0.2f;
+            if (dm < bestMid) { bestMid = dm; _mid = i; }
+            float dh = (p.X - ball.X) * (p.X - ball.X) + (p.Y - ball.Y) * (p.Y - ball.Y);
+            if (dh < bestHero) { bestHero = dh; _hero = i; }
+        }
+
+        _overlay = new Control { MouseFilter = MouseFilterEnum.Ignore };
+        _overlay.SetAnchorsPreset(LayoutPreset.FullRect);
+        AddChild(_overlay);
+        _ = Shoot();
+    }
+
+    public override void _Process(double delta)
+    {
+        var size = _pitch.Size;
+        if (size.Y > 0) _pitch.OrthoSize = Extent / (size.X / size.Y);
+    }
+
+    private async System.Threading.Tasks.Task Shoot()
+    {
+        for (int i = 0; i < 20; i++) await ToSignal(GetTree(), SceneTree.SignalName.ProcessFrame);
+        Build();
+        for (int i = 0; i < 6; i++) await ToSignal(GetTree(), SceneTree.SignalName.ProcessFrame);
+        var image = GetViewport().GetTexture().GetImage();
+        image.SavePng(_out);
+        var v = GetViewportRect().Size;
+        var t = _pitch.ScreenOf(_top); var m = _pitch.ScreenOf(_mid); var h = _pitch.ScreenOf(_hero);
+        GD.Print($"B1 {_mode} ventana={DisplayServer.WindowGetSize()} lógico={v} imagen={image.GetSize()} ortho={_pitch.OrthoSize:0.00} "
+            + $"filaSup cabeza={t.Head} pie={t.Foot} · medio cabeza={m.Head} pie={m.Foot} · protagonista pie={h.Foot}");
+        GetTree().Quit();
+    }
+
+    private void Box(float x, float y, float w, float h, string text, int font, Color? fill = null)
+    {
+        var r = new ColorRect { Position = new Vector2(x, y), Size = new Vector2(w, h), Color = fill ?? new Color(0.55f, 0.55f, 0.55f, 0.92f), MouseFilter = MouseFilterEnum.Ignore };
+        _overlay.AddChild(r);
+        var l = new Label { Text = text, Position = new Vector2(6, 4), Size = new Vector2(w - 12, h - 8), AutowrapMode = TextServer.AutowrapMode.WordSmart };
+        l.AddThemeFontSizeOverride("font_size", font);
+        l.AddThemeColorOverride("font_color", new Color(0.05f, 0.05f, 0.05f));
+        r.AddChild(l);
+    }
+
+    private void Build()
+    {
+        var v = GetViewportRect().Size; float W = v.X, H = v.Y;
+        // Tablero superior (fase B §1-2): marcador 760x110, progreso 560x12, estado especial 320x40, velocidad 4x52.
+        Box((W - 760) / 2, 16, 760, 110, "⛨ NUESTRO FC        2 ║ 1        RIVAL UTD ⛨   ▮1 ✚1", 26);
+        Box((W - 560) / 2, 134, 560, 12, "", 10, new Color(0.35f, 0.35f, 0.35f, 0.95f));
+        Box((W - 320) / 2, 152, 320, 40, "TURBA · GOL DE ORO", 18);
+        for (int i = 0; i < 4; i++) Box(W - 24 - ((4 - i) * 60), 24, 52, 52, new[] { "x1", "x4", "x16", "‖" }[i], 18);
+        Box(24, 24, 64, 64, "árb.", 17);
+        // Tiras (B2): 7 x 232x72 + banquillo 150x72, ancladas abajo.
+        float y = H - 18 - 72, x0 = (W - ((7 * 232) + (6 * 12) + 24 + 150)) / 2;
+        string[] names = { "ORZUG QUIEBRAESPINAS", "GASHK TRAGACLAVOS", "RUK MUERDEHIERRO", "YAGUL COMECRÁNEOS", "THRAK DENTAZO", "URZAG PATEAMUROS", "GROM" };
+        for (int i = 0; i < 7; i++)
+        {
+            float x = x0 + (i * 244);
+            Box(x, y, 232, 72, "", 17);
+            Box(x + 4, y + 4, 64, 64, "⛨", 26, new Color(0.35f, 0.35f, 0.35f, 0.95f));
+            var l1 = new Label { Text = $"{i + 1}  {names[i]}", Position = new Vector2(x + 74, y + 8), Size = new Vector2(144, 26), ClipText = true };
+            l1.AddThemeFontSizeOverride("font_size", 18); l1.AddThemeColorOverride("font_color", Colors.Black); _overlay.AddChild(l1);
+            var l2 = new Label { Text = "◆DEL · orco   ✦2", Position = new Vector2(x + 74, y + 38), Size = new Vector2(144, 26) };
+            l2.AddThemeFontSizeOverride("font_size", 17); l2.AddThemeColorOverride("font_color", Colors.Black); _overlay.AddChild(l2);
+            Box(x + 218, y + 4, 10, 64, "", 10, new Color(0.25f, 0.25f, 0.25f, 1f));
+        }
+        Box(x0 + (7 * 244) + 12, y, 150, 72, "BANQUILLO\n2", 18);
+
+        var top = _pitch.ScreenOf(_top); var mid = _pitch.ScreenOf(_mid); var hero = _pitch.ScreenOf(_hero);
+        if (_mode == "hud")
+        {
+            // Marca de perk 120x36 pegada a la cabeza (B3) y sello N1 150x56 12 px sobre la cabeza del jugador de la fila superior.
+            if (mid.Visible) Box(mid.Head.X - 60, mid.Head.Y - 6 - 36, 120, 36, "✦ Sangre cal.", 17);
+            if (top.Visible) Box(top.Head.X - 75, top.Head.Y - 12 - 56, 150, 56, "¡FALTA!", 26);
+            return;
+        }
+
+        // N3 (B4): 820x520 en la mitad opuesta al protagonista, centrada en vertical sobre el campo, + subtítulo 820x64.
+        bool heroLeft = hero.Foot.X < W / 2;
+        float scale = _mode == "n3dec" ? 0.7f : 1f;
+        float pw = 820 * scale, ph = 520 * scale;
+        float cx = heroLeft ? (W * 0.75f) : (W * 0.25f);
+        float py = _mode == "n3dec" ? 205 : ((H - ph - 64) / 2);
+        Box(cx - (pw / 2), py, pw, ph, "VIÑETA N3\n¡CRAC!", 40);
+        Box(cx - (pw / 2), py + ph + 6, pw, 64 * scale, "ROJA · LESIÓN GRAVE", (int)(26 * scale));
+        if (hero.Visible) Box(hero.Foot.X - 40, hero.Foot.Y - 4, 80, 8, "", 8, new Color(1f, 0.2f, 0.2f, 1f));
+        if (_mode == "n3dec")
+        {
+            // Bandeja de sustitución (B6): 1200x220 sobre el tercio inferior del campo, por encima de las tiras.
+            Box((W - 1200) / 2, y - 12 - 220, 1200, 220, "SALE [tira lesionado] → ENTRA: [tira A ✓] [tira B]   ◀ ▶ elegir · confirmar", 22);
+        }
+    }
+}
