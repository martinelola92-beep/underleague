+                    Box(870, ry + 20, 520, 32, "◀ ▶ elegir · A / clic confirmar", 20, "", new Color(0.62f, 0.62f, 0.62f, 1f));
+                }
+                else
+                {
+                    Box(290, ry + 10, 700, 52, "SIN RECAMBIO · jugáis con 6", 26, "", new Color(0.7f, 0.7f, 0.7f, 1f), true);
+                }
