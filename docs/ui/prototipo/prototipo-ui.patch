+                break;
+            }
+            case "dec":
+            case "sinrecambio":
+            {
+                // C14: la bandeja SUSTITUYE a las tiras; el campo entero sigue visible; el que sale, marcado en el campo.
+                float by = P.End.Y + 14, bh = H - 12 - by;
+                Box(24, by, W - 48, bh, "", 20, "bandeja", new Color(0.5f, 0.5f, 0.5f, 0.96f));
+                Box(40, by + 8, 200, 32, "SUSTITUCIÓN · pausa", 20, "", new Color(0.7f, 0.7f, 0.7f, 1f));
+                float ry = by + bh - 72 - 10;
+                Tira(40, ry, "4 YAGUL COMECRÁNEOS", "SALE · grave", "", new Color(0.72f, 0.45f, 0.45f, 0.95f));
+                if (_mode == "dec")
