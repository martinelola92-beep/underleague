+    private static void Blend(Image image, float x0, float y0, float x1, float y1, Color color)
+    {
+        for (int y = Mathf.Max(0, Mathf.RoundToInt(y0 * GroundPixels)); y < Mathf.Min(image.GetHeight(), Mathf.RoundToInt(y1 * GroundPixels)); y++)
+            for (int x = Mathf.Max(0, Mathf.RoundToInt(x0 * GroundPixels)); x < Mathf.Min(image.GetWidth(), Mathf.RoundToInt(x1 * GroundPixels)); x++)
+                image.SetPixel(x, y, image.GetPixel(x, y).Lerp(new Color(color.R, color.G, color.B), color.A));
+    }
