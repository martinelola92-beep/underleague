@@ -0,0 +1,27 @@
+using System.Linq;
+using Godot;
+using Underleague.Game.Autoload;
+using Underleague.Sim.Model;
+using Underleague.Sim.Run;
+namespace Underleague.Game.Screens;
+public partial class C2Check : Control
+{
+    public override void _Ready()
+    {
+        var run = RunController.Instance!;
+        run.NewRun("orc_ironworks", Race.Orc, 18);
+        run.PlayMatch(run.Available().First(n => n.IsMatch).Id);
+        var p = run.PendingSubstitution()!;
+        Dump("ANTES", run, p.Tick);
+        GD.Print($"pendiente tick={p.Tick} sale={p.OutPlayerId} candidatos={string.Join(",", p.Candidates.Select(c => c.Id + ":" + c.Name))}");
+        run.Substitute(new Substitution(p.Tick, p.OutPlayerId, p.Candidates[0].Id));
+        Dump("DESPUES", run, p.Tick + 5);
+        GetTree().Quit();
+    }
+    private static void Dump(string tag, RunController run, int tick)
+    {
+        var tr = run.Playback!.Result.Trace!; int f = tr.FrameOfTick(tick);
+        var injured = tr.Players.Select((pl, i) => (pl, i)).Where(x => x.pl.Team == 0).Select(x => $"{x.pl.Id}#{x.pl.Number} {x.pl.Name} on@{tick}={tr.OnPitchAt(f, x.i)} on@{tick - 1}={tr.OnPitchAt(tr.FrameOfTick(tick - 1), x.i)}");
+        GD.Print($"{tag}: " + string.Join(" | ", injured));
+    }
+}
