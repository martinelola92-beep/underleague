{
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet run:*)",
      "Bash(dotnet --version)",
      "Bash(dotnet --list-sdks)",
      "Bash(dotnet new:*)",
      "Bash(dotnet sln:*)",
      "Bash(dotnet add:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet format:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "/home/martinelola92/underleague/.claude/hooks/sim-game-boundary.sh" },
          { "type": "command", "command": "/home/martinelola92/underleague/.claude/hooks/subagent-add-warning.sh" },
          { "type": "command", "command": "/home/martinelola92/underleague/.claude/hooks/build-check-before-push.sh", "timeout": 600 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "/home/martinelola92/underleague/.claude/hooks/data-validation.sh" }
        ]
      }
    ]
  }
}
