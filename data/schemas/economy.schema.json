{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://underleague.dev/schemas/economy.schema.json",
  "title": "Underleague economy",
  "description": "data/economy/economy.json: economía de la run (RF-114g..k), único fichero. Enteros, valores en datos (RT-057). Cargado por Sim.Run.Systems.Economy.EconomyLoader, fuera del Catalog compartido.",
  "type": "object",
  "properties": {
    "_doc": { "type": "string" },
    "startingGold": { "type": "integer", "minimum": 0 },
    "goldAct1": { "type": "integer", "minimum": 0 },
    "goldAct2": { "type": "integer", "minimum": 0 },
    "goldAct3": { "type": "integer", "minimum": 0 },
    "difficultyMultiplierPercent": {
      "description": "RF-012: 5 niveles de dificultad, en tanto por ciento.",
      "type": "array",
      "items": { "type": "integer", "minimum": 0, "maximum": 500 },
      "minItems": 5,
      "maxItems": 5
    },
    "eliteBonusPercent": { "type": "integer", "minimum": 0, "maximum": 500 },
    "bossBonusPercent": { "type": "integer", "minimum": 0, "maximum": 500 },
    "excellentMatchBonusGold": { "type": "integer", "minimum": 0 },
    "clinicCost": { "type": "integer", "minimum": 0 },
    "rerollBaseCost": { "type": "integer", "minimum": 0 },
    "rerollStepCost": { "type": "integer", "minimum": 0 },
    "trainingExperience": { "type": "integer", "minimum": 0 },
    "eventGoldMin": { "type": "integer", "minimum": 0 },
    "eventGoldMax": { "type": "integer", "minimum": 0 },
    "mercenaryBaseWage": { "type": "integer", "minimum": 0 },
    "mercenaryWagePerRarityStep": { "type": "integer", "minimum": 0 },
    "mercenaryBenchAbandonMatches": { "type": "integer", "minimum": 1 },
    "mercenaryLossStreakAbandon": { "type": "integer", "minimum": 1 },
    "recruitLevelByAct": {
      "description": "Nivel con el que entran los fichajes de pago, los mercenarios y los jugadores de recompensa en cada acto (RF-114, RF-071). Los canteranos entran siempre en el nivel 1 (RF-114b/c).",
      "type": "array",
      "items": { "type": "integer", "minimum": 1, "maximum": 8 },
      "minItems": 3,
      "maxItems": 3
    },
    "rewardPlayerQuality": { "type": "integer", "minimum": 1, "maximum": 99 },
    "rewardPerkWeight": { "type": "integer", "minimum": 0 },
    "rewardPlayerWeight": { "type": "integer", "minimum": 0 },
    "rewardItemWeight": { "type": "integer", "minimum": 0 },
    "market": { "$ref": "#/$defs/market" }
  },
  "required": [
    "startingGold", "goldAct1", "goldAct2", "goldAct3", "difficultyMultiplierPercent",
    "eliteBonusPercent", "bossBonusPercent", "excellentMatchBonusGold",
    "clinicCost", "rerollBaseCost", "rerollStepCost", "trainingExperience",
    "eventGoldMin", "eventGoldMax", "mercenaryBaseWage", "mercenaryWagePerRarityStep",
    "mercenaryBenchAbandonMatches", "mercenaryLossStreakAbandon",
    "recruitLevelByAct", "rewardPlayerQuality", "rewardPerkWeight", "rewardPlayerWeight", "rewardItemWeight",
    "market"
  ],
  "additionalProperties": false,
  "$defs": {
    "priceByRarity": {
      "description": "[common, rare, legendary]",
      "type": "array",
      "items": { "type": "integer", "minimum": 0 },
      "minItems": 3,
      "maxItems": 3
    },
    "market": {
      "type": "object",
      "properties": {
        "playerOffers": { "type": "integer", "minimum": 0, "maximum": 4 },
        "perkOffers": { "type": "integer", "minimum": 0, "maximum": 4 },
        "itemOffers": { "type": "integer", "minimum": 0, "maximum": 4 },
        "consumableOffers": { "type": "integer", "minimum": 0, "maximum": 4 },
        "mercenaryOffers": { "type": "integer", "minimum": 0, "maximum": 4 },
        "youthMin": { "type": "integer", "minimum": 0, "maximum": 2 },
        "youthMax": { "type": "integer", "minimum": 0, "maximum": 2 },
        "playerPriceByRarity": { "$ref": "#/$defs/priceByRarity" },
        "perkPriceByRarity": { "$ref": "#/$defs/priceByRarity" },
        "itemPriceByRarity": { "$ref": "#/$defs/priceByRarity" },
        "priceSpreadPercent": {
          "description": "Dispersión del precio de cada artículo alrededor del de su rareza, en tanto por ciento (ADR 0037). Sin ella todos los artículos de una rareza cuestan lo mismo y la fracción del surtido asequible salta de 0 a 1 con el oro.",
          "type": "integer", "minimum": 0, "maximum": 90
        },
        "consumablePrice": { "type": "integer", "minimum": 0 },
        "itemSellFractionPercent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "playerSaleBaseByRarity": { "$ref": "#/$defs/priceByRarity" },
        "playerSalePerLevel": { "type": "integer", "minimum": 0 },
        "playerSalePerPerk": { "type": "integer", "minimum": 0 },
        "playerSalePerBond": { "type": "integer", "minimum": 0 },
        "recruitQuality": { "type": "integer", "minimum": 1, "maximum": 99 },
        "youthQuality": { "type": "integer", "minimum": 1, "maximum": 99 },
        "mercenaryQuality": { "type": "integer", "minimum": 1, "maximum": 99 }
      },
      "required": [
        "playerOffers", "perkOffers", "itemOffers", "consumableOffers", "mercenaryOffers",
        "youthMin", "youthMax", "playerPriceByRarity", "perkPriceByRarity", "itemPriceByRarity",
        "priceSpreadPercent", "consumablePrice", "itemSellFractionPercent", "playerSaleBaseByRarity",
        "playerSalePerLevel", "playerSalePerPerk", "playerSalePerBond",
        "recruitQuality", "youthQuality", "mercenaryQuality"
      ],
      "additionalProperties": false
    }
  }
}
