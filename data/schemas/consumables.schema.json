{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://underleague.dev/schemas/consumables.schema.json",
  "title": "Underleague consumable",
  "description": "data/consumables/<id>.json: catálogo mínimo (4, uno por familia de RF-084) para que el mercado cumpla RF-114 ('cuatro categorías simultáneas'). Añadido por el paquete X junto a data/items (ver Sim.Run.Systems.Consumables.ConsumableCatalog para el límite declarado: comprar no gatea equipar todavía). Sin campo 'description' (RT-035); mismo formato de efecto recortado que data/items.",
  "type": "object",
  "properties": {
    "_doc": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "name": { "$ref": "#/$defs/localizedName" },
    "rarity": { "enum": ["common", "uncommon", "rare", "legendary"] },
    "family": {
      "description": "RF-084: médicos, tácticos, sucios y sobrenaturales.",
      "enum": ["medical", "tactical", "dirty", "supernatural"]
    },
    "effects": {
      "type": "array",
      "items": { "$ref": "#/$defs/effect" },
      "minItems": 1
    }
  },
  "required": ["id", "name", "rarity", "family", "effects"],
  "additionalProperties": false,
  "$defs": {
    "localizedName": {
      "type": "object",
      "properties": {
        "es": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      },
      "required": ["es", "en"],
      "additionalProperties": false
    },
    "effect": {
      "type": "object",
      "properties": {
        "type": { "enum": ["modifyAttribute", "modifyProbability"] },
        "attribute": { "enum": ["strength", "speed", "technique", "stamina", "leash"] },
        "probability": {
          "enum": [
            "foul", "card", "injury", "injure", "severeInjury", "pass", "intercept",
            "dribble", "tackle", "shotOnTarget", "save", "tackleEvasion", "interceptEvasion"
          ]
        },
        "value": { "type": "integer", "minimum": -5000, "maximum": 5000, "description": "Puntos de atributo en modifyAttribute; en modifyProbability, el PORCENTAJE DE CUOTA con signo de la ADR 0050 P1 (+-15, +-30, +-50, +-100), que comprueba el cargador." }
      },
      "required": ["type", "value"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "modifyAttribute" } }, "required": ["type"] },
          "then": { "required": ["attribute"] }
        },
        {
          "if": { "properties": { "type": { "const": "modifyProbability" } }, "required": ["type"] },
          "then": { "required": ["probability"] }
        }
      ]
    }
  }
}
