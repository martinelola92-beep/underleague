{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://underleague.dev/schemas/items.schema.json",
  "title": "Underleague item",
  "description": "data/items/<id>.json: un objeto de equipamiento por fichero (RF-075..078). NO existe campo 'description': se genera desde el efecto (RT-035, Sim.Run.Systems.Items.ItemDescriptions). Los efectos reutilizan el formato de los perks (Sim.Perks.EffectDefinition) recortado a modifyAttribute y modifyProbability, sin disparador ni condición: un objeto está siempre activo mientras esté equipado.",
  "type": "object",
  "properties": {
    "_doc": { "type": "string" },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Debe coincidir con el nombre del fichero."
    },
    "name": { "$ref": "#/$defs/localizedName" },
    "rarity": { "enum": ["common", "rare", "legendary"] },
    "archetype": {
      "description": "RF-077: tres arquetipos obligatorios en el catálogo (cursed, fragile, restricted), además de normal.",
      "enum": ["normal", "cursed", "fragile", "restricted"]
    },
    "effects": {
      "type": "array",
      "items": { "$ref": "#/$defs/effect" },
      "minItems": 1
    },
    "drawbackEffects": {
      "description": "Solo en archetype=cursed: la contrapartida permanente (RF-077).",
      "type": "array",
      "items": { "$ref": "#/$defs/effect" }
    },
    "usesLimit": {
      "description": "Solo en archetype=fragile: partidos jugados con el objeto antes de romperse (RF-077).",
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "requiredTag": {
      "description": "Solo en archetype=restricted: etiqueta que debe llevar el portador (RF-077).",
      "type": "string",
      "pattern": "^[A-Z][A-Za-z]*$"
    }
  },
  "required": ["id", "name", "rarity", "archetype", "effects"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "archetype": { "const": "cursed" } }, "required": ["archetype"] },
      "then": { "required": ["drawbackEffects"], "properties": { "drawbackEffects": { "minItems": 1 } } },
      "else": { "not": { "required": ["drawbackEffects"] } }
    },
    {
      "if": { "properties": { "archetype": { "const": "fragile" } }, "required": ["archetype"] },
      "then": { "required": ["usesLimit"] },
      "else": { "not": { "required": ["usesLimit"] } }
    },
    {
      "if": { "properties": { "archetype": { "const": "restricted" } }, "required": ["archetype"] },
      "then": { "required": ["requiredTag"] },
      "else": { "not": { "required": ["requiredTag"] } }
    }
  ],
  "$defs": {
    "localizedName": {
      "type": "object",
      "properties": {
        "es": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      },
      "required": ["es", "en"],
      "additionalProperties": false
    },
    "effect": {
      "type": "object",
      "properties": {
        "type": { "enum": ["modifyAttribute", "modifyProbability"] },
        "attribute": { "enum": ["strength", "speed", "technique", "stamina", "leash"] },
        "probability": {
          "enum": [
            "foul", "card", "injury", "injure", "severeInjury", "pass", "intercept",
            "dribble", "tackle", "shotOnTarget", "save", "tackleEvasion", "interceptEvasion"
          ]
        },
        "value": { "type": "integer", "minimum": -5000, "maximum": 5000 }
      },
      "required": ["type", "value"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "modifyAttribute" } }, "required": ["type"] },
          "then": { "required": ["attribute"] }
        },
        {
          "if": { "properties": { "type": { "const": "modifyProbability" } }, "required": ["type"] },
          "then": { "required": ["probability"] }
        }
      ]
    }
  }
}
