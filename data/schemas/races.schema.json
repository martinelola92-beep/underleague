{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://underleague.dev/schemas/races.schema.json",
  "title": "Underleague race definition",
  "description": "Un fichero por raza en data/races/*.json (RaceDefinition, fase1b-diseno.md §1.1).",
  "type": "object",
  "properties": {
    "_doc": { "type": "string" },
    "id": { "$ref": "#/$defs/race" },
    "name": { "$ref": "#/$defs/localizedName" },
    "speciesTag": { "$ref": "#/$defs/race" },
    "styleTagWeights": { "$ref": "#/$defs/styleTagWeights" },
    "launch": { "type": "boolean" },
    "cellsOccupied": { "type": "integer", "minimum": 1, "maximum": 3 },
    "bodyRadius": { "type": "integer", "minimum": 1, "maximum": 200 },
    "discipline": { "type": "integer", "minimum": 0, "maximum": 100 },
    "attributeBias": { "$ref": "#/$defs/attributeBias" },
    "ability": { "type": "string", "minLength": 1, "maxLength": 64 },
    "description": { "$ref": "#/$defs/localizedName" },
    "individualDeviation": { "type": "integer", "minimum": 0, "maximum": 40 },
    "traitWeights": { "$ref": "#/$defs/traitWeights" },
    "names": { "$ref": "#/$defs/names" }
  },
  "required": [
    "id", "name", "speciesTag", "styleTagWeights", "launch", "cellsOccupied", "bodyRadius", "discipline",
    "attributeBias", "ability", "description", "individualDeviation", "traitWeights", "names"
  ],
  "additionalProperties": false,
  "$defs": {
    "race": {
      "type": "string",
      "enum": ["Human", "Orc", "Elf", "Dwarf", "Undead", "DarkElf", "Demon", "Vampire", "Lizard"]
    },
    "styleTag": {
      "type": "string",
      "enum": ["Brute", "Fine", "Bulwark", "Cold", "Neutral"]
    },
    "styleTagWeights": {
      "type": "object",
      "description": "Pesos enteros no negativos, deben sumar 100 (DataLoader lo comprueba). Dominante 60-85 y al menos una etiqueta opuesta a la identidad de la raza (ADR 0024, no verificable mecánicamente).",
      "properties": {
        "_doc": { "type": "string" },
        "Brute": { "type": "integer", "minimum": 0, "maximum": 100 },
        "Fine": { "type": "integer", "minimum": 0, "maximum": 100 },
        "Bulwark": { "type": "integer", "minimum": 0, "maximum": 100 },
        "Cold": { "type": "integer", "minimum": 0, "maximum": 100 },
        "Neutral": { "type": "integer", "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "localizedName": {
      "type": "object",
      "properties": {
        "_doc": { "type": "string" },
        "es": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      },
      "required": ["es", "en"],
      "additionalProperties": false
    },
    "attributeBias": {
      "type": "object",
      "description": "Sesgo por atributo, rango razonable -40..40 (RT-023).",
      "properties": {
        "_doc": { "type": "string" },
        "strength": { "type": "integer", "minimum": -40, "maximum": 40 },
        "speed": { "type": "integer", "minimum": -40, "maximum": 40 },
        "technique": { "type": "integer", "minimum": -40, "maximum": 40 },
        "stamina": { "type": "integer", "minimum": -40, "maximum": 40 },
        "leash": { "type": "integer", "minimum": -40, "maximum": 40 }
      },
      "required": ["strength", "speed", "technique", "stamina", "leash"],
      "additionalProperties": false
    },
    "traitWeights": {
      "type": "object",
      "description": "Peso >= 0 por rasgo no exclusivo de portero (los rasgos de portero se sortean aparte, ver tuning.generation.goalkeeperTraitChance).",
      "properties": {
        "_doc": { "type": "string" },
        "Aggressive": { "type": "integer", "minimum": 0 },
        "Fast": { "type": "integer", "minimum": 0 },
        "Scorer": { "type": "integer", "minimum": 0 },
        "LongShot": { "type": "integer", "minimum": 0 },
        "Cerebral": { "type": "integer", "minimum": 0 },
        "Dirty": { "type": "integer", "minimum": 0 },
        "Resilient": { "type": "integer", "minimum": 0 },
        "Coward": { "type": "integer", "minimum": 0 },
        "Leader": { "type": "integer", "minimum": 0 },
        "Lazy": { "type": "integer", "minimum": 0 }
      },
      "required": ["Aggressive", "Fast", "Scorer", "LongShot", "Cerebral", "Dirty", "Resilient", "Coward", "Leader", "Lazy"],
      "additionalProperties": false
    },
    "names": {
      "type": "object",
      "properties": {
        "_doc": { "type": "string" },
        "first": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "last": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
      },
      "required": ["first", "last"],
      "additionalProperties": false
    }
  }
}
