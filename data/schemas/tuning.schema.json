        "cornerTicks",
        "kickoffTicks",
        "penaltyTicks"
      ],
      "additionalProperties": false
    },
    "generation": {
      "type": "object",
      "description": "Modelo de presupuesto de la generación de jugadores (fase1b-diseno.md §1.3, ADR 0025, ADR 0027; Sim.Generation.PlayerGenerator).",
      "properties": {
        "_doc": {
          "type": "string"
        },
        "budgetByRarity": {
          "$ref": "#/$defs/rarityBudget"
        },
        "budgetPerLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "attributeFloor": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "attributeCap": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "rangeByRarity": {
          "$ref": "#/$defs/rarityRange"
        },
        "positionShare": {
          "$ref": "#/$defs/positionShare"
        },
        "positionFloors": {
          "$ref": "#/$defs/positionFloors"
        },
        "traitCountWeights": {
          "type": "array",
          "description": "Peso ponderado para elegir 1, 2 o 3 rasgos.",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 3,
          "maxItems": 3
        },
        "goalkeeperTraitChance": {
          "$ref": "#/$defs/probability"
        }
      },
      "required": [
        "budgetByRarity",
        "budgetPerLevel",
        "attributeFloor",
        "attributeCap",
        "rangeByRarity",
        "positionShare",
        "positionFloors",
        "traitCountWeights",
        "goalkeeperTraitChance"
      ],
      "additionalProperties": false
    },
    "rarityBudget": {
      "type": "object",
      "properties": {
        "_doc": { "type": "string" },
        "common": { "type": "integer", "minimum": 0, "maximum": 500 },
        "uncommon": { "type": "integer", "minimum": 0, "maximum": 500 },
        "rare": { "type": "integer", "minimum": 0, "maximum": 500 },
        "legendary": { "type": "integer", "minimum": 0, "maximum": 500 }
      },
      "required": ["common", "uncommon", "rare", "legendary"],
      "additionalProperties": false
    },
    "attributeRange": {
      "type": "object",
      "properties": {
        "_doc": { "type": "string" },
        "min": { "type": "integer", "minimum": 1, "maximum": 99 },
        "max": { "type": "integer", "minimum": 1, "maximum": 99 }
      },
      "required": ["min", "max"],
      "additionalProperties": false
    },
    "rarityRange": {
      "type": "object",
      "properties": {
        "_doc": { "type": "string" },
        "common": { "$ref": "#/$defs/attributeRange" },
        "uncommon": { "$ref": "#/$defs/attributeRange" },
        "rare": { "$ref": "#/$defs/attributeRange" },
        "legendary": { "$ref": "#/$defs/attributeRange" }
      },
      "required": ["common", "uncommon", "rare", "legendary"],
      "additionalProperties": false
    },
    "attributeShare": {
      "type": "object",
      "description": "Porcentajes 0..100 que deben sumar 100 (DataLoader lo comprueba).",
      "properties": {
        "_doc": { "type": "string" },
        "strength": { "type": "integer", "minimum": 0, "maximum": 100 },
        "speed": { "type": "integer", "minimum": 0, "maximum": 100 },
        "technique": { "type": "integer", "minimum": 0, "maximum": 100 },
        "stamina": { "type": "integer", "minimum": 0, "maximum": 100 },
        "leash": { "type": "integer", "minimum": 0, "maximum": 100 }
      },
      "required": [
        "strength",
        "speed",
        "technique",
        "stamina",
        "leash"
      ],
      "additionalProperties": false
