        },
        "reachCells": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "diveReachCells": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "divePenaltyPercent": {
          "$ref": "#/$defs/percent"
        },
        "catchBasePercent": {
          "description": "ADR 0141: base de que el portero BLOQUE el balón en vez de rechazarlo, una vez ya ha ganado el duelo de la parada.",
          "$ref": "#/$defs/percent"
        },
        "catchAttributeWeightPercent": {
          "description": "ADR 0141: cuánto ayuda a blocar el atributo relevante del portero. Un portero bueno atrapa lo que otro sólo despeja.",
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "catchQualityWeight": {
          "description": "ADR 0141: cuánto le cuesta blocar un remate bueno. Un balón que va con todo se rechaza, no se atrapa.",
          "type": "integer",
