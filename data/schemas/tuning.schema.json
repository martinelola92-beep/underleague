        "penaltyOnFoulInArea",
        "biasCardShiftPer10",
        "biasPenaltyShiftPer10",
        "biasShiftFoulSeen",
        "biasShiftFoulUnseen",
        "biasShiftHardExtra",
        "biasShiftBlockExtra",
        "biasShiftInjuryExtra",
        "biasShiftYellowExtra",
        "biasShiftRedExtra"
      ],
      "additionalProperties": false
    },
    "biasPoints": {
      "description": "Desplazamiento del criterio del árbitro, en puntos de la escala -100..+100 (RF-062, RF-063).",
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "block": {
      "description": "Resolución del bloqueo sin balón (ADR 0030 §2).",
      "type": "object",
      "properties": {
        "_doc": { "type": "string" },
        "blockingTicks": { "$ref": "#/$defs/ticks" },
        "cooldownTicks": { "$ref": "#/$defs/ticks" },
        "baseWin": { "$ref": "#/$defs/probability" },
        "strengthFactor": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "speedFactor": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "knockdownTicks": { "$ref": "#/$defs/ticks" },
        "foulBase": { "$ref": "#/$defs/probability" }
      },
      "required": [
        "blockingTicks", "cooldownTicks", "baseWin", "strengthFactor", "speedFactor",
        "knockdownTicks", "foulBase"
      ],
      "additionalProperties": false
    },
    "restart": {
      "type": "object",
      "properties": {
        "_doc": {
          "type": "string"
        },
        "throwInTicks": {
          "$ref": "#/$defs/ticks"
        },
        "goalKickTicks": {
          "$ref": "#/$defs/ticks"
        },
        "cornerTicks": {
          "$ref": "#/$defs/ticks"
        },
        "kickoffTicks": {
          "$ref": "#/$defs/ticks"
        },
        "penaltyTicks": {
          "$ref": "#/$defs/ticks"
        }
      },
