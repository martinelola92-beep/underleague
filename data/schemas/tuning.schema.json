    "positionShare": {
      "type": "object",
      "properties": {
        "_doc": { "type": "string" },
        "Goalkeeper": { "$ref": "#/$defs/attributeShare" },
        "Defender": { "$ref": "#/$defs/attributeShare" },
        "Midfielder": { "$ref": "#/$defs/attributeShare" },
        "Forward": { "$ref": "#/$defs/attributeShare" }
      },
      "required": ["Goalkeeper", "Defender", "Midfielder", "Forward"],
      "additionalProperties": false
    },
    "positionFloorEntry": {
      "type": "object",
      "description": "Suelo adicional por atributo, solo para los atributos que la posición necesita garantizados; ninguna clave es obligatoria.",
      "properties": {
