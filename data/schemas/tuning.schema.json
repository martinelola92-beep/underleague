{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://underleague.dev/schemas/tuning.schema.json",
  "title": "Underleague sim tuning",
  "description": "data/sim/tuning.json: constantes de resolución del simulador (fase0-diseno.md 2.5, 2.6). Probabilidades en base 10000 salvo que se indique 'Percent'. Todo entero salvo posiciones. Sin 'ticksPerSecond' ni 'pitch' (revisión independiente, fase 0): ninguno de los dos tenía consumidor en el motor -- la geometría del campo vive en Sim.Model.Pitch y el reloj lógico de 15/s es RT-020, no un dato de balance.",
  "type": "object",
  "properties": {
    "_doc": {
      "type": "string"
    },
    "regulationTicks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "goldenGoalMaxTicks": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "decisionIntervalTicks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "transitionTicks": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "assistWindowTicks": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "movement": {
      "$ref": "#/$defs/movement"
    },
    "ball": {
      "$ref": "#/$defs/ball"
    },
    "states": {
      "$ref": "#/$defs/states"
    },
    "pass": {
      "$ref": "#/$defs/pass"
    },
    "dribble": {
      "$ref": "#/$defs/dribble"
    },
    "shot": {
      "$ref": "#/$defs/shot"
    },
    "save": {
      "$ref": "#/$defs/save"
    },
    "tackle": {
      "$ref": "#/$defs/tackle"
    },
    "injury": {
      "$ref": "#/$defs/injury"
    },
    "probabilityChannels": {
      "$ref": "#/$defs/probabilityChannels"
    },
    "referee": {
      "$ref": "#/$defs/referee"
    },
    "block": {
      "$ref": "#/$defs/block"
    },
    "restart": {
      "$ref": "#/$defs/restart"
    },
    "generation": {
      "$ref": "#/$defs/generation"
    },
    "bodies": {
      "$ref": "#/$defs/bodies"
    },
    "actionZone": {
      "$ref": "#/$defs/actionZone"
    },
    "progression": {
      "$ref": "#/$defs/progression"
    }
  },
  "required": [
    "regulationTicks",
    "goldenGoalMaxTicks",
    "decisionIntervalTicks",
    "transitionTicks",
    "assistWindowTicks",
    "movement",
    "ball",
    "states",
    "pass",
    "dribble",
    "shot",
    "save",
    "tackle",
    "injury",
    "probabilityChannels",
    "referee",
    "block",
    "restart",
    "generation",
    "bodies",
    "actionZone",
    "progression"
  ],
  "additionalProperties": false,
  "$defs": {
    "channelStep": {
      "type": "object",
      "properties": {
        "step": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "description": "Escalon del canal en puntos porcentuales (ADR 0035). Un valor legal de modifyProbability es este escalon por 1, 2, 3, 5 o 10; eso lo comprueba Sim.Perks.PerkLoader al cargar, no este esquema."
        }
      },
      "required": ["step"],
      "additionalProperties": false
    },
    "probabilityChannels": {
      "type": "object",
      "description": "ADR 0035: escalon por canal de probabilidad. Los trece canales de Sim.Perks.ProbabilityKind, ninguno de mas ni de menos; el cargador lo vuelve a comprobar.",
      "properties": {
        "_doc": { "type": "string" },
        "foul": { "$ref": "#/$defs/channelStep" },
        "card": { "$ref": "#/$defs/channelStep" },
        "injury": { "$ref": "#/$defs/channelStep" },
        "injure": { "$ref": "#/$defs/channelStep" },
        "severeInjury": { "$ref": "#/$defs/channelStep" },
        "pass": { "$ref": "#/$defs/channelStep" },
        "intercept": { "$ref": "#/$defs/channelStep" },
        "dribble": { "$ref": "#/$defs/channelStep" },
        "tackle": { "$ref": "#/$defs/channelStep" },
        "shotOnTarget": { "$ref": "#/$defs/channelStep" },
        "save": { "$ref": "#/$defs/channelStep" },
        "tackleEvasion": { "$ref": "#/$defs/channelStep" },
        "interceptEvasion": { "$ref": "#/$defs/channelStep" }
      },
      "required": [
        "foul", "card", "injury", "injure", "severeInjury", "pass", "intercept",
        "dribble", "tackle", "shotOnTarget", "save", "tackleEvasion", "interceptEvasion"
      ],
      "additionalProperties": false
    },
    "probability": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "percent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "factor": {
      "type": "integer",
      "minimum": -1000,
      "maximum": 1000
    },
    "penalty": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "ticks": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "milli": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "attributeBiasValue": {
      "type": "integer",
      "minimum": -40,
      "maximum": 40
    },
    "movement": {
      "type": "object",
      "properties": {
        "_doc": {
          "type": "string"
        },
        "baseCellsPerTickMilli": {
          "$ref": "#/$defs/milli"
        },
        "speedCellsPerTickMilliPer99": {
          "$ref": "#/$defs/milli"
        },
        "dribbleSpeedPercent": {
          "$ref": "#/$defs/percent"
        },
        "fatigueStartTick": {
          "$ref": "#/$defs/ticks"
        },
        "fatigueMaxSlowPercent": {
          "$ref": "#/$defs/percent"
        }
      },
      "required": [
        "baseCellsPerTickMilli",
        "speedCellsPerTickMilliPer99",
        "dribbleSpeedPercent",
        "fatigueStartTick",
        "fatigueMaxSlowPercent"
      ],
      "additionalProperties": false
    },
    "ball": {
      "type": "object",
      "properties": {
        "_doc": {
          "type": "string"
        },
        "passSpeedCellsPerTickMilli": {
          "$ref": "#/$defs/milli"
        },
        "shotSpeedCellsPerTickMilli": {
          "$ref": "#/$defs/milli"
        },
        "looseBallFrictionPercent": {
          "$ref": "#/$defs/percent"
        }
      },
      "required": [
        "passSpeedCellsPerTickMilli",
        "shotSpeedCellsPerTickMilli",
        "looseBallFrictionPercent"
      ],
      "additionalProperties": false
    },
    "states": {
      "type": "object",
      "properties": {
        "_doc": {
          "type": "string"
        },
        "PassingTicks": {
          "$ref": "#/$defs/ticks"
        },
        "ShootingTicks": {
          "$ref": "#/$defs/ticks"
        },
        "TacklingTicks": {
          "$ref": "#/$defs/ticks"
        },
        "KnockedDownTicks": {
          "$ref": "#/$defs/ticks"
        },
        "CelebratingTicks": {
          "$ref": "#/$defs/ticks"
        },
        "DribbleDuelCooldownTicks": {
          "$ref": "#/$defs/ticks"
        },
        "TackleCooldownTicks": {
          "$ref": "#/$defs/ticks"
        }
      },
      "required": [
        "PassingTicks",
        "ShootingTicks",
        "TacklingTicks",
        "KnockedDownTicks",
        "CelebratingTicks",
        "DribbleDuelCooldownTicks",
        "TackleCooldownTicks"
      ],
      "additionalProperties": false
    },
    "pass": {
      "type": "object",
      "properties": {
        "_doc": {
          "type": "string"
        },
        "baseSuccess": {
          "$ref": "#/$defs/probability"
        },
        "techniqueFactor": {
          "$ref": "#/$defs/factor"
        },
        "distancePenaltyPerCell": {
          "$ref": "#/$defs/penalty"
        },
        "pressurePenalty": {
          "$ref": "#/$defs/penalty"
        },
        "interceptRadiusCells": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "interceptBaseChance": {
          "$ref": "#/$defs/probability"
        },
        "interceptTechniqueFactor": {
          "$ref": "#/$defs/factor"
        }
      },
      "required": [
        "baseSuccess",
        "techniqueFactor",
        "distancePenaltyPerCell",
        "pressurePenalty",
        "interceptRadiusCells",
        "interceptBaseChance",
        "interceptTechniqueFactor"
      ],
      "additionalProperties": false
    },
    "dribble": {
      "type": "object",
      "properties": {
        "_doc": {
          "type": "string"
        },
        "baseWin": {
          "$ref": "#/$defs/probability"
        },
        "attackerTechniqueFactor": {
          "$ref": "#/$defs/factor"
        },
        "defenderSpeedSharePercent": {
          "$ref": "#/$defs/percent"
        },
        "lostKnockdownTicks": {
          "$ref": "#/$defs/ticks"
        }
      },
      "required": [
        "baseWin",
        "attackerTechniqueFactor",
        "defenderSpeedSharePercent",
        "lostKnockdownTicks"
      ],
      "additionalProperties": false
    },
    "shot": {
      "type": "object",
      "properties": {
        "_doc": {
          "type": "string"
        },
        "baseQuality": {
          "$ref": "#/$defs/probability"
        },
        "techniqueFactor": {
          "$ref": "#/$defs/factor"
        },
        "strengthFactor": {
          "$ref": "#/$defs/factor"
        },
        "distancePenaltyPerCell": {
          "$ref": "#/$defs/penalty"
        },
        "pressurePenalty": {
          "$ref": "#/$defs/penalty"
        },
        "offTargetBase": {
          "$ref": "#/$defs/probability"
        },
        "offTargetDistanceFactor": {
          "$ref": "#/$defs/factor"
        },
        "penaltyQualityBonus": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "baseQuality",
        "techniqueFactor",
        "strengthFactor",
        "distancePenaltyPerCell",
        "pressurePenalty",
        "offTargetBase",
        "offTargetDistanceFactor",
        "penaltyQualityBonus"
      ],
      "additionalProperties": false
    },
    "save": {
      "type": "object",
      "properties": {
        "_doc": {
          "type": "string"
        },
        "basePercent": {
          "$ref": "#/$defs/percent"
        },
        "closeRangeCells": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "attributeWeightPercent": {
          "$ref": "#/$defs/percent"
        },
        "consecutiveShotDecayPercent": {
          "$ref": "#/$defs/percent"
        },
        "qualityWeight": {
          "$ref": "#/$defs/percent"
        },
        "qualityPivot": {
          "$ref": "#/$defs/percent"
        }
      },
      "required": [
        "basePercent",
        "closeRangeCells",
        "attributeWeightPercent",
        "consecutiveShotDecayPercent",
        "qualityWeight",
        "qualityPivot"
      ],
      "additionalProperties": false
    },
    "tackle": {
      "type": "object",
      "properties": {
        "_doc": {
          "type": "string"
        },
        "baseWin": {
          "$ref": "#/$defs/probability"
        },
        "pressureFactor": {
          "$ref": "#/$defs/factor"
        },
        "strengthSharePercent": {
          "$ref": "#/$defs/percent"
        },
        "foulBase": {
          "$ref": "#/$defs/probability"
        },
        "foulStrengthFactor": {
          "$ref": "#/$defs/factor"
        },
        "hardTackleThreshold": {
          "$ref": "#/$defs/probability"
        },
        "yellowCardBase": {
          "$ref": "#/$defs/probability"
        },
        "redCardBase": {
          "$ref": "#/$defs/probability"
        },
        "hardTackleYellowBonus": {
          "$ref": "#/$defs/probability"
        },
        "hardTackleRedBonus": {
          "$ref": "#/$defs/probability"
        },
        "secondYellowIsRed": {
          "type": "boolean"
        }
      },
      "required": [
        "baseWin",
        "pressureFactor",
        "strengthSharePercent",
        "foulBase",
        "foulStrengthFactor",
        "hardTackleThreshold",
        "yellowCardBase",
        "redCardBase",
        "hardTackleYellowBonus",
        "hardTackleRedBonus",
        "secondYellowIsRed"
      ],
      "additionalProperties": false
    },
    "injury": {
      "type": "object",
      "properties": {
        "_doc": {
          "type": "string"
        },
        "onTackleBase": {
          "$ref": "#/$defs/probability"
        },
        "onFoulBase": {
          "$ref": "#/$defs/probability"
        },
        "relativeFactor": {
          "$ref": "#/$defs/factor"
        },
        "severeShare": {
          "$ref": "#/$defs/probability"
        },
        "actScalePercent": {
          "description": "ADR 0043: desgaste creciente por acto. Multiplicador en tanto por ciento sobre la probabilidad de lesion, uno por acto. Solo lo aplica el bucle de run (IRunSystems.MatchConfig); un partido suelto vale 100.",
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 1000 },
          "minItems": 3,
          "maxItems": 3
        },
        "eliteScalePercent": {
          "description": "ADR 0043: recargo de desgaste del nodo de elite, en tanto por ciento, multiplicado sobre el del acto.",
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "lethality": {
          "description": "ADR 0048: la tirada de muerte de un perk letal (Sim.Perks.Lethality). Un jugador sano puede morir, asi que alcanzar ya no es matar: se marca a victimsPerActivation rivales por activacion -el que peor lo tiene- y se tira por ellos.",
          "type": "object",
          "properties": {
            "_doc": {
              "type": "string"
            },
            "relativeFactor": {
              "$ref": "#/$defs/factor"
            },
            "proximityBasePercent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "proximityStepPercent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "proximityMinPercent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "minorInjuryPercent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "severeInjuryPercent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "resistanceMinPercent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "resistanceMaxPercent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "maxChance": {
              "$ref": "#/$defs/probability"
            },
            "victimsPerActivation": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7
            }
          },
          "required": [
            "relativeFactor",
            "proximityBasePercent",
            "proximityStepPercent",
            "proximityMinPercent",
            "minorInjuryPercent",
            "severeInjuryPercent",
            "resistanceMinPercent",
            "resistanceMaxPercent",
            "maxChance",
            "victimsPerActivation"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "onTackleBase",
        "onFoulBase",
        "relativeFactor",
        "severeShare",
        "actScalePercent",
        "eliteScalePercent",
        "lethality"
      ],
      "additionalProperties": false
    },
    "referee": {
      "type": "object",
      "properties": {
        "_doc": {
          "type": "string"
        },
        "biasFoulShiftPer10": {
          "type": "integer",
          "minimum": -10000,
          "maximum": 10000
        },
        "penaltyOnFoulInArea": {
          "$ref": "#/$defs/probability"
        },
        "biasCardShiftPer10": {
          "type": "integer",
          "minimum": -10000,
          "maximum": 10000
        },
        "biasPenaltyShiftPer10": {
          "type": "integer",
          "minimum": -10000,
          "maximum": 10000
        },
        "biasShiftFoulSeen": { "$ref": "#/$defs/biasPoints" },
        "biasShiftFoulUnseen": { "$ref": "#/$defs/biasPoints" },
        "biasShiftHardExtra": { "$ref": "#/$defs/biasPoints" },
        "biasShiftBlockExtra": { "$ref": "#/$defs/biasPoints" },
        "biasShiftInjuryExtra": { "$ref": "#/$defs/biasPoints" },
        "biasShiftYellowExtra": { "$ref": "#/$defs/biasPoints" },
        "biasShiftRedExtra": { "$ref": "#/$defs/biasPoints" }
      },
      "required": [
