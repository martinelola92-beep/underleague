{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://underleague.dev/schemas/tuning.schema.json",
  "title": "Underleague sim tuning",
  "description": "data/sim/tuning.json: constantes de resolución del simulador (fase0-diseno.md 2.5, 2.6). Probabilidades en base 10000 salvo que se indique 'Percent'. Todo entero salvo posiciones. Sin 'ticksPerSecond' ni 'pitch' (revisión independiente, fase 0): ninguno de los dos tenía consumidor en el motor -- la geometría del campo vive en Sim.Model.Pitch y el reloj lógico de 15/s es RT-020, no un dato de balance.",
  "type": "object",
  "properties": {
    "_doc": {
      "type": "string"
    },
    "regulationTicks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "goldenGoalMaxTicks": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "decisionIntervalTicks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "transitionTicks": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "assistWindowTicks": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "resolution": {
      "$ref": "#/$defs/resolution"
    },
    "movement": {
      "$ref": "#/$defs/movement"
    },
    "fatigue": {
      "$ref": "#/$defs/fatigue"
    },
    "ball": {
      "$ref": "#/$defs/ball"
    },
    "states": {
      "$ref": "#/$defs/states"
    },
    "pass": {
      "$ref": "#/$defs/pass"
    },
    "dribble": {
      "$ref": "#/$defs/dribble"
    },
    "shot": {
      "$ref": "#/$defs/shot"
    },
    "cross": {
      "$ref": "#/$defs/cross"
    },
    "clear": {
      "$ref": "#/$defs/clear"
    },
    "save": {
      "$ref": "#/$defs/save"
    },
    "goalkeeper": {
      "$ref": "#/$defs/goalkeeper"
    },
    "tackle": {
      "$ref": "#/$defs/tackle"
    },
    "injury": {
      "$ref": "#/$defs/injury"
    },
    "referee": {
      "$ref": "#/$defs/referee"
    },
    "block": {
      "$ref": "#/$defs/block"
    },
    "restart": {
      "$ref": "#/$defs/restart"
    },
    "generation": {
      "$ref": "#/$defs/generation"
    },
    "bodies": {
      "$ref": "#/$defs/bodies"
    },
    "actionZone": {
      "$ref": "#/$defs/actionZone"
    },
    "progression": {
      "$ref": "#/$defs/progression"
    }
  },
  "required": [
    "regulationTicks",
    "goldenGoalMaxTicks",
    "decisionIntervalTicks",
    "transitionTicks",
    "assistWindowTicks",
    "resolution",
    "movement",
    "fatigue",
    "ball",
    "states",
    "pass",
    "dribble",
    "shot",
    "cross",
    "clear",
    "save",
    "goalkeeper",
    "tackle",
    "injury",
    "referee",
    "block",
    "restart",
    "generation",
    "bodies",
    "actionZone",
    "progression"
  ],
  "additionalProperties": false,
  "$defs": {
    "resolution": {
      "description": "ADR 0050 P4: suelo y techo unicos de las probabilidades de resolucion del balon (base 10000).",
      "type": "object",
      "properties": {
        "_doc": {
          "type": "string"
        },
        "probabilityFloor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "probabilityCeiling": {
          "type": "integer",
          "minimum": 5000,
          "maximum": 10000
        }
      },
      "required": [
        "probabilityFloor",
        "probabilityCeiling"
      ],
      "additionalProperties": false
    },
    "probability": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "percent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "factor": {
      "type": "integer",
      "minimum": -1000,
      "maximum": 1000
    },
    "penalty": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "ticks": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "milli": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "attributeBiasValue": {
      "type": "integer",
      "minimum": -40,
      "maximum": 40
    },
    "movement": {
      "type": "object",
      "properties": {
        "_doc": {
          "type": "string"
        },
        "baseCellsPerTickMilli": {
          "$ref": "#/$defs/milli"
        },
        "speedCellsPerTickMilliPer99": {
          "$ref": "#/$defs/milli"
        },
        "dribbleSpeedPercent": {
          "$ref": "#/$defs/percent"
        }
      },
      "required": [
        "baseCellsPerTickMilli",
        "speedCellsPerTickMilliPer99",
        "dribbleSpeedPercent"
      ],
      "additionalProperties": false
    },
    "fatigue": {
      "type": "object",
      "properties": {
        "_doc": {
          "type": "string"
        },
        "runCostPerTick": {
          "description": "ADR 0142: coste de correr un tick a tope, en milésimas de energía. Se cobra en proporción a lo que se corre de verdad, así que colocarse no cuesta lo mismo que perseguir.",
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "carryCostPerTick": {
          "description": "ADR 0142: coste extra por tick de llevar el balón (conducir o proteger). Llevarlo cansa más que correr suelto, y ése es el precio de la conducción de la ADR 0137.",
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "contactCost": {
          "description": "ADR 0142: coste de un esfuerzo puntual —una entrada, una carga, un salto—. Es lo que hace que la violencia también se pague con piernas.",
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "recoverPerTick": {
          "description": "ADR 0142: energía recuperada por tick sin esforzarse, antes de aplicar el aguante. Con esto existe la gestión del esfuerzo: parar recupera.",
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "maxPenaltyPoints": {
          "description": "ADR 0142: puntos de atributo que quita el cansancio con la energía a cero. Llega a velocidad, puntería, duelos, pase, tiro y decisión por un solo sitio.",
          "type": "integer",
          "minimum": 0,
          "maximum": 98
        }
      },
      "required": [
        "runCostPerTick",
        "carryCostPerTick",
        "contactCost",
        "recoverPerTick",
        "maxPenaltyPoints"
      ],
      "additionalProperties": false
    },
    "ball": {
      "type": "object",
      "properties": {
        "_doc": {
          "type": "string"
        },
        "passSpeedCellsPerTickMilli": {
          "$ref": "#/$defs/milli"
        },
        "shotSpeedCellsPerTickMilli": {
          "$ref": "#/$defs/milli"
        },
        "looseBallFrictionPercent": {
          "$ref": "#/$defs/percent"
        },
        "gravityCellsPerTickSqMilli": {
          "description": "ADR 0135: aceleración de la gravedad en milésimas de casilla por tick al cuadrado. Gobierna cuánto tarda en caer un balón por alto y, con ella, si da tiempo a que alguien llegue. Entera en milésimas como el resto de velocidades del motor; la altura resultante es float, con el mismo estatus que la X y la Y.",
          "$ref": "#/$defs/milli"
        },
        "bounceRestitutionPercent": {
          "description": "ADR 0135: porcentaje de velocidad vertical que conserva el balón al botar contra el césped. Con 45 un balón bota a menos de la mitad de alto cada vez y se para pronto, que es lo que hace un balón de fútbol sobre hierba.",
          "$ref": "#/$defs/percent"
        },
        "controlHeightCells": {
          "description": "ADR 0139: hasta esta altura el balón se CONTROLA con el pie y la recogida es la de siempre. Por encima ya no se controla: se cabecea.",
          "type": "number",
          "minimum": 0,
          "maximum": 4
        },
        "aerialReachHeightCells": {
          "description": "ADR 0139: hasta esta altura el balón se alcanza SALTANDO (cabezazo, y duelo aéreo si hay rivales). Por encima no lo toca nadie, y ésa es la razón de que un centro o un despeje puedan pasar por encima de todo el mundo.",
          "type": "number",
          "minimum": 0,
          "maximum": 6
        },
        "headerSpeedCellsPerTickMilli": {
          "description": "ADR 0139: a qué velocidad sale el balón cabeceado. Un cabezazo PROLONGA la jugada, no la cierra: el balón sigue suelto y eso es la segunda jugada. BI-E lo sube de 180 a 320 —era más lento que un pase— porque con la velocidad vieja el balón no salía del grupo y lo cabeceaba el siguiente.",
          "$ref": "#/$defs/milli"
        },
        "headerDropCellsPerTickMilli": {
          "description": "BI-E: con qué velocidad DESCENDENTE sale el balón cabeceado. Era un impulso hacia arriba (headerLift) y con él el balón se quedaba a la altura de la cabeza: medidas cadenas de hasta ochenta duelos seguidos, con el balón recorriendo 0,72 casillas entre uno y otro. Un cabezazo devuelve el balón al suelo, que es donde se juega.",
          "$ref": "#/$defs/milli"
        }
      },
      "required": [
        "passSpeedCellsPerTickMilli",
        "shotSpeedCellsPerTickMilli",
        "looseBallFrictionPercent",
        "gravityCellsPerTickSqMilli",
        "bounceRestitutionPercent",
        "controlHeightCells",
        "aerialReachHeightCells",
        "headerSpeedCellsPerTickMilli",
        "headerDropCellsPerTickMilli"
      ],
      "additionalProperties": false
    },
    "states": {
      "type": "object",
      "properties": {
        "_doc": {
          "type": "string"
        },
        "PassingTicks": {
          "$ref": "#/$defs/ticks"
        },
        "ShootingTicks": {
          "$ref": "#/$defs/ticks"
        },
        "TacklingTicks": {
          "$ref": "#/$defs/ticks"
        },
        "KnockedDownTicks": {
          "$ref": "#/$defs/ticks"
        },
        "CelebratingTicks": {
          "$ref": "#/$defs/ticks"
        },
        "DribbleDuelCooldownTicks": {
          "$ref": "#/$defs/ticks"
        },
        "TackleCooldownTicks": {
          "$ref": "#/$defs/ticks"
        },
        "OffBallTackleCooldownTicks": {
          "$ref": "#/$defs/ticks"
        },
        "ShieldingTicks": {
          "description": "Gameplay AI Foundations Pass P2: cuánto dura el compromiso de proteger el balón. Mismo patrón que dribble.driveTicks (ADR 0137): mientras dura, el portador no vuelve a decidir.",
          "$ref": "#/$defs/ticks"
        },
        "GrudgeTicks": {
          "description": "ADR 0145: cuánto le dura a un jugador el rencor contra el rival que le rompió a un compañero delante. Caduca a propósito: una represalia que no caduca deja de ser una reacción y pasa a ser un rasgo.",
          "$ref": "#/$defs/ticks"
        },
        "AerialCooldownTicks": {
          "description": "ADR 0139: ticks que un jugador tarda en poder volver a disputar un balón por alto. Estructural, no calibración: sin él, el que cabecea sigue pegado al balón y lo vuelve a disputar al tick siguiente —medido, 88 duelos aéreos por partido—.",
          "$ref": "#/$defs/ticks"
        }
      },
      "required": [
        "PassingTicks",
        "ShootingTicks",
        "TacklingTicks",
        "KnockedDownTicks",
        "CelebratingTicks",
        "DribbleDuelCooldownTicks",
        "TackleCooldownTicks",
        "OffBallTackleCooldownTicks",
        "ShieldingTicks",
        "AerialCooldownTicks",
        "GrudgeTicks"
      ],
      "additionalProperties": false
    },
    "pass": {
      "type": "object",
      "properties": {
        "_doc": {
          "type": "string"
        },
        "baseSuccess": {
          "$ref": "#/$defs/probability"
        },
        "techniqueFactor": {
          "$ref": "#/$defs/factor"
        },
        "distancePenaltyPerCell": {
          "$ref": "#/$defs/penalty"
        },
        "pressurePenalty": {
          "$ref": "#/$defs/penalty"
        },
        "interceptRadiusCells": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "interceptBaseChance": {
          "$ref": "#/$defs/probability"
        },
        "interceptTechniqueFactor": {
          "$ref": "#/$defs/factor"
        },
        "maxLeadCells": {
          "type": "number",
          "minimum": 0,
          "description": "Techo absoluto del adelanto del pase, en casillas (AZ-B paso 1)."
        },
        "interceptContactPercent": {
          "type": "integer",
          "minimum": 100,
          "description": "Factor de proximidad de la intercepción en contacto, en tanto por ciento (AZ-B paso 2)."
        },
        "loftedPeakHeightCellsMilli": {
          "description": "ADR 0139: altura del pico de un pase LARGO que sale elevado porque tiene el pasillo tapado. Menor que la del centro: levantar la pelota por encima de un rival no es lo mismo que colgarla al área.",
          "$ref": "#/$defs/milli"
        }
      },
      "required": [
        "baseSuccess",
        "techniqueFactor",
        "distancePenaltyPerCell",
        "pressurePenalty",
        "interceptRadiusCells",
        "interceptBaseChance",
        "interceptTechniqueFactor",
        "maxLeadCells",
        "interceptContactPercent",
        "loftedPeakHeightCellsMilli"
      ],
      "additionalProperties": false
    },
    "dribble": {
      "type": "object",
      "properties": {
        "_doc": {
          "type": "string"
        },
        "baseWin": {
          "$ref": "#/$defs/probability"
        },
        "attackerTechniqueFactor": {
          "$ref": "#/$defs/factor"
        },
        "defenderSpeedSharePercent": {
          "$ref": "#/$defs/percent"
        },
        "lostKnockdownTicks": {
          "$ref": "#/$defs/ticks"
        },
        "driveTicks": {
          "$ref": "#/$defs/ticks"
        },
        "driveTicksTechniqueSharePercent": {
          "$ref": "#/$defs/percent"
        }
      },
      "required": [
        "baseWin",
        "attackerTechniqueFactor",
        "defenderSpeedSharePercent",
        "lostKnockdownTicks",
        "driveTicks",
        "driveTicksTechniqueSharePercent"
      ],
      "additionalProperties": false
    },
    "shot": {
      "type": "object",
      "properties": {
        "_doc": {
          "type": "string"
        },
        "baseQuality": {
          "$ref": "#/$defs/probability"
        },
        "techniqueFactor": {
          "$ref": "#/$defs/factor"
        },
        "strengthFactor": {
          "$ref": "#/$defs/factor"
        },
        "distancePenaltyPerCell": {
          "$ref": "#/$defs/penalty"
        },
        "pressurePenalty": {
          "$ref": "#/$defs/penalty"
        },
        "offTargetBase": {
          "$ref": "#/$defs/probability"
        },
        "offTargetDistanceFactor": {
          "$ref": "#/$defs/factor"
        },
        "penaltyQualityBonus": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "goalHalfWidthCellsMilli": {
          "description": "ADR 0135 paso 2: semiancho de la portería en milésimas de casilla, medido sobre la fila (Y) desde el centro del campo. Con 1000 la portería ocupa 2 de las 7 filas. Encaja con offTargetShotDeviationCells (1,25), que deja el tiro fuera justo por detrás del poste.",
          "$ref": "#/$defs/milli"
        },
        "goalHeightCellsMilli": {
          "description": "ADR 0135 paso 2: alto de la portería en milésimas de casilla. Con 700 y un semiancho de 1000, la proporción alto/ancho es ~1:3, la de una portería real. De aquí sale 'se fue por encima'.",
          "$ref": "#/$defs/milli"
        },
        "postThicknessCellsMilli": {
          "description": "ADR 0135 paso 2b: grosor del marco en milésimas de casilla. Un disparo que cruza la línea a menos de esta distancia del poste o del larguero DA EN EL MARCO y sale rechazado en vez de ser gol. No es el grosor real de un poste -sería invisible a esta escala-, es cuánto margen de error convierte un tiro al rincón en un tiro a la madera.",
          "$ref": "#/$defs/milli"
        },
        "arcCellsPerCellMilli": {
          "description": "ADR 0135 paso 2: cuánto se eleva el tiro a mitad de vuelo por cada casilla de distancia, en milésimas. Es la comba del disparo, no su altura de llegada: un tiro lejano describe más parábola. Sólo afecta a por dónde PASA el balón, que es lo que el paso 3 usará para decidir si alguien lo alcanza.",
          "$ref": "#/$defs/milli"
        },
        "blockChancePercent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "minAimApertureCenti": {
          "description": "ADR 0135 paso 3a: SUELO de la apertura cuando divide el error de puntería. El error de un tirador es angular, en su pie, así que en el plano de la portería se desplaza 1/cos(ángulo) = 1/apertura — una asíntota: desde el cordel exacto la apertura es 0 y el error sería infinito. Este suelo es el multiplicador máximo del error. Guarda numérica de una asíntota, no un ajuste de dificultad. Se publica en 100, que hace el divisor exactamente 1: el paso 3a de la ADR 0135 va apagado a la espera de una decisión del revisor (ficha BA-E).",
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "offTargetAperturePenalty": {
          "description": "ADR 0135 paso 3a: cuánto sube la cuota de irse FUERA por cada centésima de apertura que falta (apertura 100 = de frente, no suma nada; apertura 0 = suma entero). Misma escala y misma expresión que offTargetDistanceFactor, a propósito: la apertura entra donde ya entra la distancia, no por un camino nuevo. Sin este término, dividir el error sólo produce tiros recortados al marco —una fábrica de palos— porque quien decide si el disparo va dentro es esta tirada y no la geometría (ficha BH-C). Se publica en 0: medido, este término es quien produce el 89 % del efecto del paso 3a, así que encenderlo es la decisión, no un ajuste.",
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "baseQuality",
        "techniqueFactor",
        "strengthFactor",
        "distancePenaltyPerCell",
        "pressurePenalty",
        "offTargetBase",
        "offTargetDistanceFactor",
        "penaltyQualityBonus",
        "blockChancePercent",
        "goalHalfWidthCellsMilli",
        "goalHeightCellsMilli",
        "arcCellsPerCellMilli",
        "postThicknessCellsMilli",
        "minAimApertureCenti",
        "offTargetAperturePenalty"
      ],
      "additionalProperties": false
    },
    "clear": {
      "type": "object",
      "properties": {
        "_doc": {
          "type": "string"
        },
        "baseDistanceCells": {
          "description": "Casillas que recorre el despeje de un jugador de fuerza 50.",
          "type": "number",
          "minimum": 0,
          "maximum": 16
        },
        "strengthDistanceMilliPerPoint": {
          "description": "Milésimas de casilla más de alcance por punto de fuerza sobre 50: despejar es golpear, no colocar.",
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        },
        "peakHeightCellsMilli": {
          "description": "Altura del pico de la parábola. Igualada a cross.peakHeightCellsMilli: es la altura que el motor ya sabe que salva a un defensa (ADR 0136).",
          "$ref": "#/$defs/milli"
        },
        "pressurePenaltyCells": {
          "description": "BI-F: casillas de alcance que pierde un despeje por tener al rival encima. Sin esta distinción, un saque de puerta —golpeado solo y con el balón parado— llegaba tan corto como un despeje angustiado y caía entre los rivales.",
          "type": "number",
          "minimum": 0,
          "maximum": 16
        },
        "spreadRows": {
          "description": "Dispersión lateral en filas. Un despeje APROXIMA el destino en vez de elegirlo.",
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        }
      },
      "required": [
        "baseDistanceCells",
        "strengthDistanceMilliPerPoint",
        "peakHeightCellsMilli",
        "spreadRows",
        "pressurePenaltyCells"
      ],
      "additionalProperties": false
    },
    "cross": {
      "type": "object",
      "properties": {
        "_doc": {
          "type": "string"
        },
        "peakHeightCellsMilli": {
          "description": "ADR 0136: altura del vuelo del centro en milésimas de casilla y en ABSOLUTO (FlightArc es el pico de la parábola, porque 4t(1-t) vale 1 en t=0,5). Tiene que superar pass.interceptRadiusCells, o el centro se intercepta como un pase raso y la acción no hace nada.",
          "$ref": "#/$defs/milli"
        },
        "volleyBaseQuality": {
          "$ref": "#/$defs/probability"
        },
        "volleyTechniqueFactor": {
          "description": "ADR 0136: deliberadamente MENOR que shot.techniqueFactor. El tiro es colocar; el remate es llegar y empujarla.",
          "$ref": "#/$defs/factor"
        },
        "volleyStrengthFactor": {
          "description": "ADR 0136: deliberadamente MAYOR que shot.strengthFactor y que volleyTechniqueFactor. Es lo que da identidad propia al rematador frente al tirador.",
          "$ref": "#/$defs/factor"
        },
        "volleyOffTargetPenalty": {
          "description": "ADR 0136: se suma a shot.offTargetBase en el remate. El precio de golpear sin controlar el balón antes.",
          "$ref": "#/$defs/probability"
        }
      },
      "required": [
        "peakHeightCellsMilli",
        "volleyBaseQuality",
        "volleyTechniqueFactor",
        "volleyStrengthFactor",
        "volleyOffTargetPenalty"
      ],
      "additionalProperties": false
    },
