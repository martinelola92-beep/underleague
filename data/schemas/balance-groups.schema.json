{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://underleague.dev/schemas/balance-groups.schema.json",
  "title": "Grupos de builds para las métricas de fase 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["coherent", "bad", "random", "baselineByRace"],
  "properties": {
    "_doc": { "type": "string" },
    "coherent": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "bad": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "random": { "type": "array", "items": { "type": "string" } },
    "baselineByRace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "_doc": { "type": "string" },
        "Human": { "type": "string" }, "Orc": { "type": "string" }, "Elf": { "type": "string" },
        "Dwarf": { "type": "string" }, "Undead": { "type": "string" }, "DarkElf": { "type": "string" },
        "Demon": { "type": "string" }, "Vampire": { "type": "string" }, "Lizard": { "type": "string" }
      }
    }
  }
}
