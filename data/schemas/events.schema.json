{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Carta de evento (ADR 0100)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description",
    "minAct",
    "weight",
    "options"
  ],
  "properties": {
    "_doc": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "name": {
      "$ref": "#/$defs/localized"
    },
    "description": {
      "$ref": "#/$defs/localized"
    },
    "minAct": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "weight": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "effects"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "name": {
            "$ref": "#/$defs/localized"
          },
          "needsTarget": {
            "type": "boolean"
          },
          "effects": {
            "type": "array",
            "minItems": 0,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "value"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "gold",
                    "goldShare",
                    "heal",
                    "experience",
                    "experienceTarget",
                    "injure"
                  ]
                },
                "value": {
                  "type": "integer",
                  "minimum": -100,
                  "maximum": 1000
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "localized": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "es",
        "en"
      ],
      "properties": {
        "es": {
          "type": "string"
        },
        "en": {
          "type": "string"
        }
      }
    }
  }
}
